<UserControl x:Class="Cleaner.App.Controls.CleanerPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:items="clr-namespace:Cleaner.App.ViewModels.Items"
             xmlns:vm="clr-namespace:Cleaner.App.ViewModels.Pages"
             xmlns:l="clr-namespace:Cleaner.App.Localization"
             x:Name="Self"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900"
             d:DataContext="{d:DesignInstance Type=vm:CleanerPageViewModelBase}">

    <Grid DataContext="{Binding ViewModel, ElementName=Self}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="{Binding ElementName=Self, Path=PageTitle}" Style="{StaticResource PageTitle}" />
            <TextBlock Text="{Binding ElementName=Self, Path=PageSubtitle}" Style="{StaticResource PageSubtitle}" />
        </StackPanel>

        <!-- Action-Toolbar / Stats -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal">
                    <ui:Button Appearance="Primary"
                               Icon="{ui:SymbolIcon Search24}"
                               Content="{l:T Cleaner.ScanStart}"
                               Command="{Binding ScanAllCommand}"
                               IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolToVis}}"
                               Margin="0,0,12,0" />
                    <ui:DropDownButton Appearance="Danger"
                                       Icon="{ui:SymbolIcon Delete24}"
                                       Content="{l:T Cleaner.CleanSelected}"
                                       Tag="{Binding .}">
                        <ui:DropDownButton.Flyout>
                            <ContextMenu>
                                <MenuItem Header="{l:T Cleaner.MoveToRecycleBin}"
                                          Command="{Binding PlacementTarget.Tag.CleanSelectedCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="recycle">
                                    <MenuItem.Icon><ui:SymbolIcon Symbol="Delete24" /></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="{l:T Cleaner.DeletePermanent}"
                                          Command="{Binding PlacementTarget.Tag.CleanSelectedCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="permanent">
                                    <MenuItem.Icon><ui:SymbolIcon Symbol="DeleteOff24" Foreground="{StaticResource WarningBrush}" /></MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </ui:DropDownButton.Flyout>
                    </ui:DropDownButton>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <StackPanel Margin="24,0">
                        <TextBlock Style="{StaticResource StatLabel}" Text="{l:T Cleaner.Found}" />
                        <TextBlock FontSize="22" FontWeight="SemiBold"
                                   Text="{Binding TotalScannedSize, Converter={StaticResource BytesToSize}}" />
                    </StackPanel>
                    <StackPanel Margin="24,0">
                        <TextBlock Style="{StaticResource StatLabel}" Text="{l:T Cleaner.Selected}" />
                        <TextBlock FontSize="22" FontWeight="SemiBold"
                                   Foreground="{DynamicResource CleanerAccentBrush}"
                                   Text="{Binding TotalSelectedSize, Converter={StaticResource BytesToSize}}" />
                    </StackPanel>
                    <StackPanel Margin="24,0">
                        <TextBlock Style="{StaticResource StatLabel}" Text="{l:T Cleaner.Freed}" />
                        <TextBlock FontSize="22" FontWeight="SemiBold"
                                   Foreground="{StaticResource SafeBrush}"
                                   Text="{Binding TotalFreedSize, Converter={StaticResource BytesToSize}}" />
                    </StackPanel>
                </StackPanel>

                <ui:Button Grid.Row="0" Grid.Column="2"
                           Appearance="Caution"
                           Content="{l:T Cancel}"
                           Command="{Binding CancelCommand}"
                           Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"
                           VerticalAlignment="Center" />

                <!-- Zweite Toolbar-Zeile: Profile, Suche, Export -->
                <Grid Grid.Row="1" Grid.ColumnSpan="3" Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="Star24" Margin="0,0,8,0" Opacity="0.7" VerticalAlignment="Center" />
                        <Grid Width="180" VerticalAlignment="Center">
                            <ComboBox ItemsSource="{Binding ProfileNames}"
                                      SelectedItem="{Binding SelectedProfileName, Mode=TwoWay}"
                                      ToolTip="{l:T Cleaner.Profile}" />
                            <!-- Platzhalter wenn noch keine Profile gespeichert sind -->
                            <TextBlock Text="{l:T Cleaner.ProfileNone}" Opacity="0.5" FontSize="12"
                                       Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                       Visibility="{Binding ProfileNames.Count, Converter={StaticResource InverseBoolToVisFromInt}}" />
                        </Grid>
                        <ui:Button Appearance="Secondary" Margin="6,0,0,0" Padding="8,4"
                                   Icon="{ui:SymbolIcon Checkmark24}"
                                   Content="{l:T Cleaner.ProfileApply}"
                                   Command="{Binding ApplyProfileCommand}" />
                        <ui:Button Appearance="Secondary" Margin="6,0,0,0" Padding="8,4"
                                   Icon="{ui:SymbolIcon Save24}"
                                   Content="{l:T Cleaner.ProfileSave}"
                                   Command="{Binding SaveProfileAsCommand}" />
                        <ui:Button Appearance="Transparent" Margin="6,0,0,0" Padding="8,4"
                                   Icon="{ui:SymbolIcon Delete24}"
                                   ToolTip="{l:T Cleaner.ProfileDelete}"
                                   Command="{Binding DeleteProfileCommand}" />
                    </StackPanel>

                    <DockPanel Grid.Column="1" Margin="16,0" LastChildFill="True">
                        <!-- Alters-Filter: nur Dateien älter als X Tage (global, gilt für alle Cleaner) -->
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center"
                                    ToolTip="{l:T Cleaner.OlderThanHint}">
                            <ui:SymbolIcon Symbol="CalendarClock24" Opacity="0.7" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="{l:T Cleaner.OlderThan}" VerticalAlignment="Center" FontSize="12" Margin="0,0,6,0" />
                            <ui:NumberBox Width="92" Minimum="0" Maximum="3650"
                                          Value="{Binding Settings.CleanMinAgeDays, Mode=TwoWay}" />
                            <TextBlock Text="{l:T Cleaner.Days}" VerticalAlignment="Center" FontSize="12" Margin="6,0,0,0" />
                        </StackPanel>

                        <ui:TextBox MaxWidth="280" HorizontalAlignment="Right" Margin="16,0,0,0"
                                    VerticalAlignment="Center"
                                    PlaceholderText="{l:T Cleaner.Search}"
                                    Icon="{ui:SymbolIcon Search24}"
                                    Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                    </DockPanel>

                    <ui:Button Grid.Column="2" Appearance="Secondary" Padding="8,4"
                               Icon="{ui:SymbolIcon ArrowExport24}"
                               Content="{l:T Cleaner.Export}"
                               Command="{Binding ExportCommand}"
                               VerticalAlignment="Center" />
                </Grid>
            </Grid>
        </Border>

        <!-- Cleaner-Liste -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type items:CleanupTargetItemViewModel}">
                            <Border BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                    BorderThickness="0,0,0,1">
                                <Expander Background="Transparent" BorderThickness="0"
                                          Padding="12,4"
                                          IsEnabled="{Binding HasScanResult}">
                                    <Expander.Header>
                                        <Grid Margin="4,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="120" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <CheckBox IsChecked="{Binding IsSelected}"
                                                      VerticalAlignment="Center" Margin="0,0,12,0" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" />
                                                    <Border CornerRadius="8" Padding="6,1" Margin="10,0,0,0"
                                                            VerticalAlignment="Center"
                                                            Background="{Binding SafetyLevel, Converter={StaticResource SafetyToBrush}}">
                                                        <TextBlock Text="{Binding SafetyLevel, Converter={StaticResource SafetyToText}}"
                                                                   Foreground="White" FontSize="10" FontWeight="SemiBold" />
                                                    </Border>
                                                    <Border CornerRadius="8" Padding="6,1" Margin="6,0,0,0"
                                                            VerticalAlignment="Center"
                                                            Background="#553B3B3B"
                                                            Visibility="{Binding RequiresAdmin, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="{l:T Cleaner.AdminBadge}" Foreground="White" FontSize="10" FontWeight="SemiBold" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Description}"
                                                           Opacity="0.75" TextWrapping="Wrap"
                                                           MaxWidth="700" HorizontalAlignment="Left"
                                                           Margin="0,4,0,0" FontSize="12" />
                                                <TextBlock Text="{Binding StatusMessage}"
                                                           Opacity="0.6" FontSize="11"
                                                           Margin="0,4,0,0"
                                                           Visibility="{Binding StatusMessage, Converter={StaticResource NullToVis}}" />
                                            </StackPanel>
                                            <ui:ProgressRing Grid.Column="2" IsIndeterminate="True"
                                                             Width="22" Height="22" Margin="16,0"
                                                             Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}" />
                                            <StackPanel Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                <TextBlock FontSize="18" FontWeight="SemiBold"
                                                           HorizontalAlignment="Right"
                                                           Foreground="{StaticResource SafeBrush}"
                                                           Text="{Binding ScannedSize, Converter={StaticResource BytesToSize}}" />
                                                <TextBlock FontSize="11" Opacity="0.6"
                                                           HorizontalAlignment="Right">
                                                    <Run Text="{Binding ScannedFiles, Mode=OneWay}" />
                                                    <Run Text=" Datei(en)" />
                                                </TextBlock>
                                            </StackPanel>

                                            <!-- Einzel-Aufräumen: räumt nur diese Kategorie, andere Scan-Ergebnisse bleiben erhalten -->
                                            <ui:Button Grid.Column="4"
                                                       Appearance="Secondary"
                                                       Icon="{ui:SymbolIcon Delete24}"
                                                       Content="{l:T Cleaner.CleanThis}"
                                                       VerticalAlignment="Center" Margin="12,0,0,0"
                                                       IsEnabled="{Binding HasScanResult}"
                                                       Visibility="{Binding HasScanResult, Converter={StaticResource BoolToVis}}"
                                                       Command="{Binding DataContext.CleanItemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                       CommandParameter="{Binding}" />
                                        </Grid>
                                    </Expander.Header>

                                    <!-- Detail-Bereich: Pfad-Liste mit Aktionen -->
                                    <Border Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                            Padding="36,10,16,14" Margin="0,4,0,0" CornerRadius="6">
                                        <StackPanel>
                                            <TextBlock FontSize="11" Opacity="0.7" Margin="0,0,0,8"
                                                       Text="{l:T Cleaner.PathsHeaderShort}" />
                                            <ItemsControl ItemsSource="{Binding VisiblePaths}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,1" Background="Transparent"
                                                              ContextMenu="{StaticResource FileSystemPathMenu}"
                                                              Tag="{Binding}">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <Grid.InputBindings>
                                                                <MouseBinding MouseAction="LeftDoubleClick"
                                                                              Command="{Binding DataContext.OpenPathCommand, RelativeSource={RelativeSource AncestorType=Expander}}"
                                                                              CommandParameter="{Binding}" />
                                                            </Grid.InputBindings>
                                                            <TextBlock Text="{Binding}" FontFamily="Cascadia Mono, Consolas"
                                                                       FontSize="11" VerticalAlignment="Center"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                                <ui:Button Appearance="Transparent" Padding="6,2" Margin="4,0,0,0"
                                                                           Icon="{ui:SymbolIcon Folder24}"
                                                                           ToolTip="Im Explorer öffnen"
                                                                           Command="{Binding DataContext.OpenPathCommand, RelativeSource={RelativeSource AncestorType=Expander}}"
                                                                           CommandParameter="{Binding}" />
                                                                <ui:Button Appearance="Transparent" Padding="6,2" Margin="4,0,0,0"
                                                                           Icon="{ui:SymbolIcon Copy24}"
                                                                           ToolTip="Pfad kopieren"
                                                                           Command="{Binding DataContext.CopyPathCommand, RelativeSource={RelativeSource AncestorType=Expander}}"
                                                                           CommandParameter="{Binding}" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock FontSize="11" Opacity="0.6" Margin="0,8,0,0"
                                                       Visibility="{Binding HiddenPathCount, Converter={StaticResource NullToVis}}">
                                                <Run Text="... und " />
                                                <Run Text="{Binding HiddenPathCount, Mode=OneWay}" />
                                                <Run Text=" weitere Pfade (UI-Limit, alle werden aber gelöscht)" />
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </Expander>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Status / Progress -->
        <Border Grid.Row="3" Margin="0,20,0,0" Padding="0">
            <StackPanel>
                <TextBlock Text="{Binding StatusText}" Opacity="0.8" />
                <ProgressBar Height="4" Margin="0,8,0,0"
                             Minimum="0" Maximum="100"
                             Value="{Binding ScanProgress, Mode=OneWay}"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
