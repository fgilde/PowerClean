<UserControl x:Class="Cleaner.App.Controls.PowerGrid"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:l="clr-namespace:Cleaner.App.Localization"
             x:Name="Self"
             Loaded="PowerGrid_OnLoaded"
             mc:Ignorable="d"
             d:DesignHeight="400" d:DesignWidth="900">
    <UserControl.Resources>
        <!-- Wird nur bei aktiver Gruppierung ans DataGrid gehängt: ein statisch definierter
             GroupStyle bricht die Star-/Pixel-Breitenverteilung der Spalten (alle kleben auf
             MinWidth), sobald er existiert — auch ohne GroupDescriptions. -->
        <GroupStyle x:Key="PowerGridGroupStyle">
            <GroupStyle.ContainerStyle>
                <Style TargetType="GroupItem">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="GroupItem">
                                <Expander IsExpanded="True" Margin="0,4,0,0">
                                    <Expander.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                                    CornerRadius="8" Padding="8,1" Margin="10,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ItemCount}" FontSize="11" Opacity="0.8" />
                                            </Border>
                                        </StackPanel>
                                    </Expander.Header>
                                    <ItemsPresenter />
                                </Expander>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </GroupStyle.ContainerStyle>
        </GroupStyle>

        <!-- Schicke Zeilen: Hover subtil, Selektion mit Akzent-Balken links + getönter Fläche -->
        <Style x:Key="PowerGridRowStyle" TargetType="DataGridRow">
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="3,0,0,0" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource CleanerAccentBrush}" />
                </Trigger>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsSelected" Value="True" />
                        <Condition Property="IsMouseOver" Value="True" />
                    </MultiTrigger.Conditions>
                    <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource CleanerAccentBrush}" />
                </MultiTrigger>
            </Style.Triggers>
        </Style>
        <!-- Zellen: kein hässlicher Focus-/Selektions-Rahmen, Row-Style macht die Optik -->
        <Style x:Key="PowerGridCellStyle" TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Toolbar: Suche · Gruppierung · Spalten · Ansichten -->
        <Border Grid.Row="0" Padding="12,10"
                BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ui:TextBox x:Name="SearchBox"
                            MaxWidth="340"
                            HorizontalAlignment="Left"
                            Icon="{ui:SymbolIcon Search24}"
                            PlaceholderText="{l:T Grid.Search}"
                            TextChanged="SearchBox_OnTextChanged" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <TextBlock Text="{l:T Grid.GroupBy}" VerticalAlignment="Center" Opacity="0.7" Margin="0,0,8,0" />
                    <ComboBox x:Name="GroupCombo" MinWidth="140"
                              DropDownOpened="GroupCombo_OnDropDownOpened"
                              SelectionChanged="GroupCombo_OnSelectionChanged" />
                </StackPanel>

                <ui:Button Grid.Column="2" Margin="12,0,0,0"
                           Appearance="Secondary"
                           Icon="{ui:SymbolIcon ColumnTriple24}"
                           Content="{l:T Grid.Columns}"
                           Click="ColumnsButton_OnClick" />

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <TextBlock Text="{l:T Grid.View}" VerticalAlignment="Center" Opacity="0.7" Margin="0,0,8,0" />
                    <ComboBox x:Name="ViewCombo" MinWidth="130"
                              SelectionChanged="ViewCombo_OnSelectionChanged" />
                    <ui:Button Margin="6,0,0,0" Appearance="Secondary" Padding="6,4"
                               Icon="{ui:SymbolIcon Save24}"
                               ToolTip="{l:T Grid.SaveView}"
                               Click="SaveViewButton_OnClick" />
                    <ui:Button x:Name="DeleteViewButton" Margin="4,0,0,0" Appearance="Secondary" Padding="6,4"
                               Icon="{ui:SymbolIcon Delete24}"
                               ToolTip="{l:T Grid.DeleteView}"
                               IsEnabled="False"
                               Click="DeleteViewButton_OnClick" />
                </StackPanel>

                <!-- Popup: Spalten ein-/ausblenden -->
                <Popup x:Name="ColumnsPopup" StaysOpen="False" AllowsTransparency="True" Placement="Bottom"
                       PlacementTarget="{Binding ElementName=Self}">
                    <Border Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="12" MinWidth="220">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.3" />
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="{l:T Grid.Columns}" FontWeight="SemiBold" Margin="0,0,0,8" />
                            <ItemsControl x:Name="ColumnsList" />
                        </StackPanel>
                    </Border>
                </Popup>

                <!-- Popup: Ansicht speichern -->
                <Popup x:Name="SaveViewPopup" StaysOpen="False" AllowsTransparency="True" Placement="Bottom"
                       PlacementTarget="{Binding ElementName=ViewCombo}">
                    <Border Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="12" MinWidth="260">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.3" />
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="{l:T Grid.SaveViewPrompt}" FontWeight="SemiBold" Margin="0,0,0,8" />
                            <ui:TextBox x:Name="ViewNameBox" PlaceholderText="{l:T Grid.ViewNamePlaceholder}"
                                        KeyDown="ViewNameBox_OnKeyDown" />
                            <ui:Button Margin="0,10,0,0" Appearance="Primary" HorizontalAlignment="Right"
                                       Content="{l:T Save}" Click="ConfirmSaveView_OnClick" />
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>
        </Border>

        <DataGrid x:Name="InnerGrid" Grid.Row="1"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False" CanUserDeleteRows="False"
                  CanUserReorderColumns="True" CanUserResizeColumns="True" CanUserSortColumns="True"
                  SelectionMode="Extended" SelectionUnit="FullRow"
                  HeadersVisibility="Column" GridLinesVisibility="None"
                  Background="Transparent" BorderThickness="0"
                  RowBackground="Transparent" AlternatingRowBackground="#08000000"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  CellStyle="{StaticResource PowerGridCellStyle}"
                  RowStyle="{StaticResource PowerGridRowStyle}" />
    </Grid>
</UserControl>
