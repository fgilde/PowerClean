<ui:FluentWindow x:Class="Cleaner.App.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:pages="clr-namespace:Cleaner.App.Views.Pages"
                 xmlns:l="clr-namespace:Cleaner.App.Localization"
                 xmlns:controls="clr-namespace:Cleaner.App.Controls"
                 Title="{l:T AppTitle}"
                 Width="1280" Height="820"
                 MinWidth="980" MinHeight="640"
                 WindowBackdropType="Mica"
                 ExtendsContentIntoTitleBar="True"
                 WindowStartupLocation="CenterScreen"
                 Background="{DynamicResource ApplicationBackgroundBrush}"
                 Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                 TextOptions.TextFormattingMode="Display"
                 Icon="pack://application:,,,/Assets/PowerClean.ico"
                 mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Title="PowerClean"
                     Grid.Row="0"
                     ShowMaximize="True"
                     ShowMinimize="True">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/PowerClean.ico" />
            </ui:TitleBar.Icon>
            <ui:TitleBar.Header>
                <!-- Info-Button — überall oben rechts erreichbar, öffnet die About-Seite -->
                <ui:Button Appearance="Transparent"
                           Icon="{ui:SymbolIcon Info24}"
                           ToolTip="{l:T Nav.About}"
                           Padding="8,4"
                           Margin="0,0,4,0"
                           WindowChrome.IsHitTestVisibleInChrome="True"
                           Click="InfoButton_Click" />
            </ui:TitleBar.Header>
        </ui:TitleBar>

        <ui:NavigationView x:Name="RootNavigation"
                           Grid.Row="1"
                           PaneDisplayMode="Left"
                           IsBackButtonVisible="Collapsed"
                           OpenPaneLength="240">
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem Content="{l:T Nav.Dashboard}" TargetPageType="{x:Type pages:DashboardPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Home24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>

                <ui:NavigationViewItem Content="{l:T Nav.System}" TargetPageType="{x:Type pages:SystemCleanerPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Broom24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>

                <ui:NavigationViewItem Content="{l:T Nav.Developer}" TargetPageType="{x:Type pages:DeveloperCleanerPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Code24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>

                <ui:NavigationViewItem Content="{l:T Nav.Disk}" TargetPageType="{x:Type pages:DiskAnalyzerPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="DataTreemap24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>

                <ui:NavigationViewItem Content="{l:T Nav.Duplicates}" TargetPageType="{x:Type pages:DuplicatesPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="DocumentCopy24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>

                <ui:NavigationViewItem Content="{l:T Nav.FolderCompare}" TargetPageType="{x:Type pages:FolderComparePage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="BranchCompare24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>

                <ui:NavigationViewItem Content="{l:T Nav.LargeFiles}" TargetPageType="{x:Type pages:LargeFilesPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="DocumentSearch24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>

                <ui:NavigationViewItem Content="{l:T Nav.LogFinder}" TargetPageType="{x:Type pages:LogFinderPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="DocumentText24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>

                <ui:NavigationViewItem Content="{l:T Nav.OrphanData}" TargetPageType="{x:Type pages:OrphanUserDataPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="FolderProhibited24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>

                <ui:NavigationViewItem Content="{l:T Nav.History}" TargetPageType="{x:Type pages:CleanupHistoryPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="History24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>

                <ui:NavigationViewItemSeparator />

                <ui:NavigationViewItem Content="{l:T Nav.Autostart}" TargetPageType="{x:Type pages:AutostartPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Rocket24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>

                <ui:NavigationViewItem Content="{l:T Nav.Programs}" TargetPageType="{x:Type pages:InstalledProgramsPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="AppFolder24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>

                <ui:NavigationViewItem Content="{l:T Nav.Services}" TargetPageType="{x:Type pages:ServicesPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Server24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>

                <ui:NavigationViewItem Content="{l:T Nav.Processes}" TargetPageType="{x:Type pages:ProcessMonitorPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Pulse24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>

                <ui:NavigationViewItem Content="{l:T Nav.KillProfiles}" TargetPageType="{x:Type pages:KillProfilesPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Flash24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>

                <ui:NavigationViewItemSeparator />

                <ui:NavigationViewItem Content="{l:T Nav.Registry}" TargetPageType="{x:Type pages:RegistryCleanerPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Database24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>

                <ui:NavigationViewItem Content="{l:T Nav.Maintenance}" TargetPageType="{x:Type pages:SystemMaintenancePage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Wrench24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
            </ui:NavigationView.MenuItems>

            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem Content="{l:T Nav.About}" TargetPageType="{x:Type pages:AboutPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Info24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="{l:T Nav.Settings}" TargetPageType="{x:Type pages:SettingsPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Settings24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
            </ui:NavigationView.FooterMenuItems>
        </ui:NavigationView>

        <!-- Background-Task-Status-Strip -->
        <Border Grid.Row="2"
                Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                Padding="20,6"
                Visibility="{Binding ElementName=TasksHost, Path=DataContext.Count, Converter={StaticResource BoolToVisFromInt}}">
            <Button x:Name="TasksTriggerButton"
                    Background="Transparent" BorderThickness="0"
                    Cursor="Hand" HorizontalContentAlignment="Left"
                    HorizontalAlignment="Stretch"
                    Click="TasksTriggerButton_Click">
                <StackPanel Orientation="Horizontal">
                    <ui:ProgressRing IsIndeterminate="True" Width="16" Height="16" Margin="0,0,10,0" />
                    <TextBlock VerticalAlignment="Center" FontSize="12">
                        <Run Text="{Binding ElementName=TasksHost, Path=DataContext.Count, Mode=OneWay}" />
                        <Run Text=" Aktion(en) laufen — Klick für Details" />
                    </TextBlock>
                </StackPanel>
            </Button>
        </Border>

        <!-- Hidden host to expose TaskRegistry to the popup -->
        <ContentControl x:Name="TasksHost" Visibility="Collapsed" />

        <Popup x:Name="TasksPopup"
               PlacementTarget="{Binding ElementName=TasksTriggerButton}"
               Placement="Top"
               StaysOpen="False"
               AllowsTransparency="True"
               PopupAnimation="Fade">
            <Border Margin="8">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="2" Opacity="0.3" />
                </Border.Effect>
                <controls:RunningTasksPanel DataContext="{Binding ElementName=TasksHost, Path=DataContext}" />
            </Border>
        </Popup>
    </Grid>
</ui:FluentWindow>
