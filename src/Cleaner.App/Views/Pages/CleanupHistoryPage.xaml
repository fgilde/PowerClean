<UserControl x:Class="Cleaner.App.Views.Pages.CleanupHistoryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:vm="clr-namespace:Cleaner.App.ViewModels.Pages"
      xmlns:l="clr-namespace:Cleaner.App.Localization"
      xmlns:svc="clr-namespace:Cleaner.App.Services"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance Type=vm:CleanupHistoryViewModel}">
    <Grid Margin="40,24,40,40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="{l:T History.Title}" Style="{StaticResource PageTitle}" />
            <TextBlock Text="{l:T History.Subtitle}" Style="{StaticResource PageSubtitle}" />
        </StackPanel>

        <!-- Toolbar / Stats -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Style="{StaticResource StatLabel}" Text="{l:T History.TotalFreed}" />
                        <TextBlock FontSize="22" FontWeight="SemiBold"
                                   Foreground="{StaticResource SafeBrush}"
                                   Text="{Binding ViewModel.TotalFreedAllTime, Converter={StaticResource BytesToSize}}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button Appearance="Secondary" Icon="{ui:SymbolIcon Delete24}"
                               Content="{l:T History.OpenRecycleBin}"
                               Command="{Binding ViewModel.OpenRecycleBinCommand}" Margin="0,0,8,0" />
                    <ui:Button Appearance="Caution" Icon="{ui:SymbolIcon Eraser24}"
                               Content="{l:T History.Clear}"
                               Command="{Binding ViewModel.ClearCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Verlauf-Liste -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
            <Grid>
                <TextBlock Text="{l:T History.Empty}" Opacity="0.6"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding ViewModel.IsEmpty, Converter={StaticResource BoolToVis}}" />
                <DataGrid ItemsSource="{Binding ViewModel.Entries}"
                          AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                          HeadersVisibility="Column" GridLinesVisibility="None"
                          Background="Transparent" BorderThickness="0"
                          RowBackground="Transparent" AlternatingRowBackground="#08000000"
                          IsReadOnly="True"
                          Visibility="{Binding ViewModel.IsEmpty, Converter={StaticResource InverseBoolToVis}}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{l:T History.Col.Time}" Width="160"
                                            Binding="{Binding CleanedAt, StringFormat='{}{0:dd.MM.yyyy HH:mm}'}" />
                        <DataGridTextColumn Header="{l:T History.Col.Target}" Width="*"
                                            Binding="{Binding TargetName}" />
                        <DataGridTextColumn Header="{l:T History.Col.Files}" Width="90"
                                            Binding="{Binding FilesDeleted}" />
                        <DataGridTextColumn Header="{l:T History.Col.Size}" Width="110"
                                            Binding="{Binding FreedBytes, Converter={StaticResource BytesToSize}}" />
                        <DataGridTemplateColumn Header="{l:T History.Col.Mode}" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type svc:CleanupHistoryEntry}">
                                    <Grid VerticalAlignment="Center">
                                        <TextBlock Text="{l:T History.ModeRecycle}" FontSize="12"
                                                   Visibility="{Binding UsedRecycleBin, Converter={StaticResource BoolToVis}}" />
                                        <TextBlock Text="{l:T History.ModePermanent}" FontSize="12"
                                                   Foreground="{StaticResource WarningBrush}"
                                                   Visibility="{Binding UsedRecycleBin, Converter={StaticResource InverseBoolToVis}}" />
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="" Width="200">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type svc:CleanupHistoryEntry}">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <ui:Button Appearance="Secondary" Padding="6,2" FontSize="11"
                                                   Icon="{ui:SymbolIcon ArrowUndo24}" Content="{l:T History.Restore}"
                                                   Visibility="{Binding UsedRecycleBin, Converter={StaticResource BoolToVis}}"
                                                   Command="{Binding DataContext.ViewModel.RestoreCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                   CommandParameter="{Binding}" />
                                        <ui:Button Appearance="Transparent" Padding="6,2" FontSize="11" Margin="4,0,0,0"
                                                   Icon="{ui:SymbolIcon Dismiss24}"
                                                   ToolTip="{l:T History.RemoveEntry}"
                                                   Command="{Binding DataContext.ViewModel.RemoveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                   CommandParameter="{Binding}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <StackPanel Grid.Row="3" Margin="0,16,0,0">
            <TextBlock Text="{Binding ViewModel.StatusText}" Opacity="0.8" />
        </StackPanel>
    </Grid>
</UserControl>
