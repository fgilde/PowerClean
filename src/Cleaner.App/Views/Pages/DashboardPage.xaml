<UserControl x:Class="Cleaner.App.Views.Pages.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:vm="clr-namespace:Cleaner.App.ViewModels.Pages"
      xmlns:l="clr-namespace:Cleaner.App.Localization"
      xmlns:core="clr-namespace:Cleaner.Core.Services;assembly=Cleaner.Core"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance Type=vm:DashboardViewModel}"
      >
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="40,24,40,40">
        <StackPanel>
            <!-- Greeting -->
            <TextBlock Text="{Binding ViewModel.Greeting}" Style="{StaticResource PageTitle}" />
            <TextBlock Text="{l:T Dashboard.Subtitle}"
                       Style="{StaticResource PageSubtitle}" />

            <!-- Quick-Actions + Status -->
            <Border Style="{StaticResource Card}" Margin="0,8,0,24">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal">
                            <ui:Button Appearance="Primary"
                                       Icon="{ui:SymbolIcon Search24}"
                                       Content="{l:T Dashboard.QuickScan}"
                                       Command="{Binding ViewModel.QuickScanCommand}"
                                       IsEnabled="{Binding ViewModel.IsBusy, Converter={StaticResource InverseBoolToVis}}"
                                       Margin="0,0,12,0" />
                            <ui:DropDownButton Appearance="Danger"
                                               Icon="{ui:SymbolIcon Broom24}"
                                               Content="{l:T Dashboard.CleanAll}"
                                               Tag="{Binding ViewModel}"
                                               Margin="0,0,12,0">
                                <ui:DropDownButton.Flyout>
                                    <ContextMenu>
                                        <MenuItem Header="{l:T Cleaner.MoveToRecycleBin}"
                                                  Command="{Binding PlacementTarget.Tag.QuickCleanCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="recycle">
                                            <MenuItem.Icon><ui:SymbolIcon Symbol="Delete24" /></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="{l:T Cleaner.DeletePermanent}"
                                                  Command="{Binding PlacementTarget.Tag.QuickCleanCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="permanent">
                                            <MenuItem.Icon><ui:SymbolIcon Symbol="DeleteOff24" Foreground="{StaticResource WarningBrush}" /></MenuItem.Icon>
                                        </MenuItem>
                                    </ContextMenu>
                                </ui:DropDownButton.Flyout>
                            </ui:DropDownButton>
                            <ui:Button Appearance="Caution"
                                       Icon="{ui:SymbolIcon Dismiss24}"
                                       Content="{l:T Stop}"
                                       Command="{Binding ViewModel.CancelCommand}"
                                       Visibility="{Binding ViewModel.IsBusy, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>

                        <Border Grid.Column="2" Padding="20,8" Background="{DynamicResource ControlFillColorDefaultBrush}"
                                CornerRadius="6" VerticalAlignment="Center">
                            <StackPanel>
                                <TextBlock Style="{StaticResource StatLabel}" Text="{l:T Dashboard.PotentialSavings}" />
                                <TextBlock Style="{StaticResource StatNumber}"
                                           Foreground="{StaticResource SafeBrush}"
                                           Text="{Binding ViewModel.PotentialSavings, Converter={StaticResource BytesToSize}}" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid Margin="0,12,0,0"
                          Visibility="{Binding ViewModel.IsBusy, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ProgressBar Minimum="0" Maximum="100"
                                     Value="{Binding ViewModel.ScanProgress, Mode=OneWay}"
                                     Height="6" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Margin="12,0,0,0" Opacity="0.8"
                                   Text="{Binding ViewModel.ScanStatus}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Insights -->
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource StatLabel}" Text="{l:T Dashboard.FreedAllTime}" />
                        <TextBlock Style="{StaticResource StatNumber}"
                                   Foreground="{StaticResource SafeBrush}"
                                   Text="{Binding ViewModel.FreedAllTime, Converter={StaticResource BytesToSize}}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource Card}" Margin="8,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource StatLabel}" Text="{l:T Dashboard.FreedThisMonth}" />
                        <TextBlock Style="{StaticResource StatNumber}"
                                   Text="{Binding ViewModel.FreedThisMonth, Converter={StaticResource BytesToSize}}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}" Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource StatLabel}" Text="{l:T Dashboard.Health}" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource StatNumber}"
                                       Foreground="{DynamicResource CleanerAccentBrush}"
                                       Text="{Binding ViewModel.HealthScore}" />
                            <TextBlock Text="/100" VerticalAlignment="Bottom" Opacity="0.5" Margin="2,0,8,4" />
                            <TextBlock Text="{Binding ViewModel.HealthLabel}" VerticalAlignment="Bottom"
                                       Opacity="0.8" Margin="0,0,0,4" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Drives -->
            <TextBlock Text="{l:T Dashboard.Drives}" FontSize="18" FontWeight="SemiBold" Margin="0,8,0,12" />
            <ItemsControl ItemsSource="{Binding ViewModel.Drives}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type core:DriveSummary}">
                        <Border Style="{StaticResource Card}" Width="280" Margin="0,0,16,16">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ui:SymbolIcon Symbol="HardDrive24" FontSize="28" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="{Binding Name}" />
                                        <TextBlock Style="{StaticResource StatLabel}" Text="{Binding Label}" />
                                    </StackPanel>
                                </Grid>

                                <ProgressBar Margin="0,16,0,8" Height="6" Minimum="0" Maximum="1"
                                             Value="{Binding UsedPercent, Mode=OneWay}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock>
                                        <Run Text="{Binding UsedSpace, Converter={StaticResource BytesToSize}, Mode=OneWay}" />
                                        <Run Text=" von " />
                                        <Run Text="{Binding TotalSize, Converter={StaticResource BytesToSize}, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock Grid.Column="1" Opacity="0.7">
                                        <Run Text="{Binding FreeSpace, Converter={StaticResource BytesToSize}, Mode=OneWay}" />
                                        <Run Text=" frei" />
                                    </TextBlock>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Windows-Tools -->
            <TextBlock Text="{l:T Dashboard.WindowsTools}" FontSize="18" FontWeight="SemiBold" Margin="0,16,0,12" />
            <Border Style="{StaticResource Card}" Padding="0">
                <UniformGrid Columns="3">
                    <Button Background="Transparent" BorderThickness="0" Padding="16"
                            Cursor="Hand" HorizontalContentAlignment="Stretch"
                            Command="{Binding ViewModel.OpenWindowsStorageCommand}"
                            ToolTip="Öffnet Einstellungen › System › Speicher">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Symbol="DataPie24" FontSize="24" VerticalAlignment="Center"
                                           Foreground="{DynamicResource CleanerAccentBrush}" />
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock FontWeight="SemiBold" Text="{l:T Tools.Storage}" />
                                <TextBlock Style="{StaticResource StatLabel}"
                                           Text="{l:T Tools.StorageDesc}" />
                            </StackPanel>
                        </Grid>
                    </Button>
                    <Button Background="Transparent" BorderThickness="0" Padding="16"
                            Cursor="Hand" HorizontalContentAlignment="Stretch"
                            Command="{Binding ViewModel.OpenStorageRecommendationsCommand}"
                            ToolTip="Bereinigungsempfehlungen von Windows">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Symbol="LightbulbCircle24" FontSize="24" VerticalAlignment="Center"
                                           Foreground="{DynamicResource CleanerAccentBrush}" />
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock FontWeight="SemiBold" Text="{l:T Tools.Recommendations}" />
                                <TextBlock Style="{StaticResource StatLabel}"
                                           Text="{l:T Tools.RecommendationsDesc}" />
                            </StackPanel>
                        </Grid>
                    </Button>
                    <Button Background="Transparent" BorderThickness="0" Padding="16"
                            Cursor="Hand" HorizontalContentAlignment="Stretch"
                            Command="{Binding ViewModel.OpenDiskCleanupCommand}"
                            ToolTip="Klassische Datenträgerbereinigung (cleanmgr.exe)">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Symbol="Broom24" FontSize="24" VerticalAlignment="Center"
                                           Foreground="{DynamicResource CleanerAccentBrush}" />
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock FontWeight="SemiBold" Text="{l:T Tools.DiskCleanup}" />
                                <TextBlock Style="{StaticResource StatLabel}"
                                           Text="{l:T Tools.DiskCleanupDesc}" />
                            </StackPanel>
                        </Grid>
                    </Button>
                    <Button Background="Transparent" BorderThickness="0" Padding="16"
                            Cursor="Hand" HorizontalContentAlignment="Stretch"
                            Command="{Binding ViewModel.OpenWindowsAppsListCommand}"
                            ToolTip="Installierte Apps verwalten / deinstallieren">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Symbol="AppFolder24" FontSize="24" VerticalAlignment="Center"
                                           Foreground="{DynamicResource CleanerAccentBrush}" />
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock FontWeight="SemiBold" Text="{l:T Tools.AppsMgmt}" />
                                <TextBlock Style="{StaticResource StatLabel}"
                                           Text="{l:T Tools.AppsMgmtDesc}" />
                            </StackPanel>
                        </Grid>
                    </Button>
                    <Button Background="Transparent" BorderThickness="0" Padding="16"
                            Cursor="Hand" HorizontalContentAlignment="Stretch"
                            Command="{Binding ViewModel.OpenTaskManagerCommand}"
                            ToolTip="Windows Task-Manager öffnen">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Symbol="Pulse24" FontSize="24" VerticalAlignment="Center"
                                           Foreground="{DynamicResource CleanerAccentBrush}" />
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock FontWeight="SemiBold" Text="{l:T Tools.TaskManager}" />
                                <TextBlock Style="{StaticResource StatLabel}"
                                           Text="{l:T Tools.TaskManagerDesc}" />
                            </StackPanel>
                        </Grid>
                    </Button>
                </UniformGrid>
            </Border>

            <!-- Quick-Cleanup-Liste -->
            <TextBlock Text="{l:T Dashboard.SuggestedActions}" FontSize="18" FontWeight="SemiBold" Margin="0,24,0,12" />
            <Border Style="{StaticResource Card}" Padding="0">
                <ItemsControl ItemsSource="{Binding ViewModel.SuggestedCleanups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:QuickCleanItem}">
                            <Border BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                    BorderThickness="0,0,0,1">
                                <Expander Background="Transparent" BorderThickness="0"
                                          Padding="12,4"
                                          IsEnabled="{Binding HasResult}">
                                    <Expander.Header>
                                        <Grid Margin="4,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="120" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" />
                                                    <Border CornerRadius="8" Padding="6,1" Margin="10,0,0,0"
                                                            VerticalAlignment="Center"
                                                            Background="{Binding SafetyLevel, Converter={StaticResource SafetyToBrush}}">
                                                        <TextBlock Text="{Binding SafetyLevel, Converter={StaticResource SafetyToText}}"
                                                                   Foreground="White" FontSize="10" FontWeight="SemiBold" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding StatusMessage}" Opacity="0.7" FontSize="11" Margin="0,3,0,0"
                                                           Visibility="{Binding StatusMessage, Converter={StaticResource NullToVis}}" />
                                            </StackPanel>

                                            <ui:ProgressRing Grid.Column="1" IsIndeterminate="True"
                                                             Width="20" Height="20" Margin="0,0,16,0"
                                                             Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}" />

                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,16,0">
                                                <TextBlock FontWeight="SemiBold"
                                                           Foreground="{StaticResource SafeBrush}"
                                                           HorizontalAlignment="Right"
                                                           Text="{Binding Size, Converter={StaticResource BytesToSize}}" />
                                                <TextBlock FontSize="11" Opacity="0.6" HorizontalAlignment="Right">
                                                    <Run Text="{Binding Files, Mode=OneWay}" />
                                                    <Run Text=" Datei(en)" />
                                                </TextBlock>
                                            </StackPanel>

                                            <ui:DropDownButton Grid.Column="3" Appearance="Secondary"
                                                       Icon="{ui:SymbolIcon Delete24}"
                                                       Content="{l:T Cleaner.CleanSelected}"
                                                       Padding="10,4" FontSize="12"
                                                       Tag="{Binding DataContext.ViewModel, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                       Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}">
                                                <ui:DropDownButton.Flyout>
                                                    <ContextMenu>
                                                        <MenuItem Header="{l:T Cleaner.MoveToRecycleBin}"
                                                                  Command="{Binding PlacementTarget.Tag.CleanOneRecycleCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                                            <MenuItem.Icon><ui:SymbolIcon Symbol="Delete24" /></MenuItem.Icon>
                                                        </MenuItem>
                                                        <MenuItem Header="{l:T Cleaner.DeletePermanent}"
                                                                  Command="{Binding PlacementTarget.Tag.CleanOnePermanentCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                                            <MenuItem.Icon><ui:SymbolIcon Symbol="DeleteOff24" Foreground="{StaticResource WarningBrush}" /></MenuItem.Icon>
                                                        </MenuItem>
                                                    </ContextMenu>
                                                </ui:DropDownButton.Flyout>
                                            </ui:DropDownButton>
                                        </Grid>
                                    </Expander.Header>

                                    <!-- Detail-Bereich: Pfade -->
                                    <Border Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                            Padding="36,10,16,14" Margin="0,4,0,0" CornerRadius="6">
                                        <StackPanel>
                                            <TextBlock FontSize="11" Opacity="0.7" Margin="0,0,0,8"
                                                       Text="{l:T Cleaner.PathsHeaderShort}" />
                                            <ItemsControl ItemsSource="{Binding VisiblePaths}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,1" Background="Transparent">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <Grid.InputBindings>
                                                                <MouseBinding MouseAction="LeftDoubleClick"
                                                                              Command="{Binding DataContext.OpenPathCommand, RelativeSource={RelativeSource AncestorType=Expander}}"
                                                                              CommandParameter="{Binding}" />
                                                            </Grid.InputBindings>
                                                            <TextBlock Text="{Binding}" FontFamily="Cascadia Mono, Consolas"
                                                                       FontSize="11" VerticalAlignment="Center"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                                <ui:Button Appearance="Transparent" Padding="6,2" Margin="4,0,0,0"
                                                                           Icon="{ui:SymbolIcon Folder24}"
                                                                           ToolTip="Im Explorer öffnen"
                                                                           Command="{Binding DataContext.OpenPathCommand, RelativeSource={RelativeSource AncestorType=Expander}}"
                                                                           CommandParameter="{Binding}" />
                                                                <ui:Button Appearance="Transparent" Padding="6,2" Margin="4,0,0,0"
                                                                           Icon="{ui:SymbolIcon Copy24}"
                                                                           ToolTip="Pfad kopieren"
                                                                           Command="{Binding DataContext.CopyPathCommand, RelativeSource={RelativeSource AncestorType=Expander}}"
                                                                           CommandParameter="{Binding}" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock FontSize="11" Opacity="0.6" Margin="0,8,0,0"
                                                       Visibility="{Binding HiddenPathCount, Converter={StaticResource NullToVis}}">
                                                <Run Text="... und " />
                                                <Run Text="{Binding HiddenPathCount, Mode=OneWay}" />
                                                <Run Text=" weitere (UI-Limit, alle werden gelöscht)" />
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </Expander>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
