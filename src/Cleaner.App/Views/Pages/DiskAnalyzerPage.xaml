<UserControl x:Class="Cleaner.App.Views.Pages.DiskAnalyzerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:vm="clr-namespace:Cleaner.App.ViewModels.Pages"
      xmlns:l="clr-namespace:Cleaner.App.Localization"
      xmlns:controls="clr-namespace:Cleaner.App.Controls"
      xmlns:core="clr-namespace:Cleaner.Core.Services;assembly=Cleaner.Core"
      xmlns:m="clr-namespace:Cleaner.Core.Models;assembly=Cleaner.Core"
      xmlns:items="clr-namespace:Cleaner.App.ViewModels.Items"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance Type=vm:DiskAnalyzerViewModel}"
      >
    <Grid Margin="40,24,40,40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="{l:T Disk.Title}" Style="{StaticResource PageTitle}" />
            <TextBlock Text="{l:T Disk.Subtitle}"
                       Style="{StaticResource PageSubtitle}" />
        </StackPanel>

        <!-- Toolbar -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="{l:T Disk.Drive}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox Grid.Column="1" Width="200"
                          ItemsSource="{Binding ViewModel.AvailableDrives}"
                          SelectedItem="{Binding ViewModel.SelectedDrive}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type core:DriveSummary}">
                            <TextBlock>
                                <Run Text="{Binding Name, Mode=OneWay}" />
                                <Run Text=" — " />
                                <Run Text="{Binding Label, Mode=OneWay}" />
                            </TextBlock>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <Grid Grid.Column="2" Margin="16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBox PlaceholderText="{l:T Disk.CustomPath}"
                                Text="{Binding ViewModel.CustomPath, UpdateSourceTrigger=PropertyChanged}" />
                    <ui:Button Grid.Column="1" Appearance="Secondary" Padding="10,6" Margin="6,0,0,0"
                               Icon="{ui:SymbolIcon Folder24}"
                               ToolTip="{l:T Disk.BrowseFolder}"
                               Command="{Binding ViewModel.BrowseFolderCommand}" />
                </Grid>

                <ui:Button Grid.Column="3" Appearance="Primary"
                           Icon="{ui:SymbolIcon Search24}"
                           Content="{l:T Cleaner.ScanStart}"
                           Command="{Binding ViewModel.ScanCommand}"
                           IsEnabled="{Binding ViewModel.IsScanning, Converter={StaticResource InverseBoolToVis}}" />

                <ui:Button Grid.Column="4" Appearance="Caution" Margin="8,0,0,0"
                           Icon="{ui:SymbolIcon Dismiss24}"
                           Content="{l:T Stop}"
                           Command="{Binding ViewModel.CancelCommand}"
                           Visibility="{Binding ViewModel.IsScanning, Converter={StaticResource BoolToVis}}" />

                <ui:Button Grid.Column="5" Appearance="Secondary" Margin="8,0,0,0"
                           Icon="{ui:SymbolIcon ArrowUp24}"
                           Content="{l:T Up}"
                           Command="{Binding ViewModel.GoUpCommand}" />
            </Grid>
        </Border>

        <!-- Breadcrumb -->
        <ItemsControl Grid.Row="2" ItemsSource="{Binding ViewModel.Breadcrumb}" Margin="0,0,0,12">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type m:FileSystemNode}">
                    <StackPanel Orientation="Horizontal">
                        <ui:HyperlinkButton Content="{Binding Name}"
                                            Command="{Binding DataContext.ViewModel.NavigateBreadcrumbCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />
                        <TextBlock Text="›" VerticalAlignment="Center" Opacity="0.5" Margin="4,0" />
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Treemap + Top-Liste -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="380" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}" Padding="2">
                <controls:TreemapControl x:Name="Treemap"
                                         RootNode="{Binding ViewModel.CurrentNode}" />
            </Border>

            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="16,0,0,0" Padding="0">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="16,16,16,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock FontSize="14" FontWeight="SemiBold" Text="{l:T Disk.TopEntries}" />
                            <TextBlock FontSize="11" Opacity="0.6">
                                <Run Text="{l:T Disk.CurrentFolder}" />
                                <Run Text="{Binding ViewModel.CurrentNodeFileCount, Mode=OneWay}" />
                                <Run Text=" Datei(en)" />
                            </TextBlock>
                        </StackPanel>
                        <TextBlock Grid.Column="1" FontWeight="SemiBold" VerticalAlignment="Center"
                                   Foreground="{StaticResource SafeBrush}"
                                   Text="{Binding ViewModel.CurrentNodeSize, Converter={StaticResource BytesToSize}}" />
                    </Grid>
                    <TreeView ItemsSource="{Binding ViewModel.TreeRoots}"
                              Background="Transparent" BorderThickness="0"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                            </Style>
                        </TreeView.ItemContainerStyle>
                        <TreeView.Resources>
                            <ContextMenu x:Key="NodeContextMenu">
                                <MenuItem Header="{l:T DrillIn}"
                                          Command="{Binding PlacementTarget.Tag.ViewModel.DrillIntoVmCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding}">
                                    <MenuItem.Icon><ui:SymbolIcon Symbol="ZoomIn24" /></MenuItem.Icon>
                                </MenuItem>
                                <Separator />
                                <MenuItem Header="{l:T Reveal}"
                                          Command="{Binding PlacementTarget.Tag.ViewModel.OpenInExplorerCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding}">
                                    <MenuItem.Icon><ui:SymbolIcon Symbol="Folder24" /></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="{l:T OpenWith}"
                                          Command="{Binding PlacementTarget.Tag.ViewModel.OpenWithCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding}">
                                    <MenuItem.Icon><ui:SymbolIcon Symbol="Open24" /></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="{l:T TerminalOpen}"
                                          Command="{Binding PlacementTarget.Tag.ViewModel.OpenInTerminalCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding}">
                                    <MenuItem.Icon><ui:SymbolIcon Symbol="WindowConsole20" /></MenuItem.Icon>
                                </MenuItem>
                                <Separator />
                                <MenuItem Header="{l:T CopyPath}"
                                          Command="{Binding PlacementTarget.Tag.ViewModel.CopyPathCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding}">
                                    <MenuItem.Icon><ui:SymbolIcon Symbol="Copy24" /></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="{l:T WindowsProperties}"
                                          Command="{Binding PlacementTarget.Tag.ViewModel.ShowPropertiesCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding}">
                                    <MenuItem.Icon><ui:SymbolIcon Symbol="Info24" /></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="{l:T OpenWith}"
                                          ToolTip="Windows 'Öffnen mit'-Dialog"
                                          Command="{Binding PlacementTarget.Tag.ViewModel.OpenWithDialogCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding}">
                                    <MenuItem.Icon><ui:SymbolIcon Symbol="AppsListDetail24" /></MenuItem.Icon>
                                </MenuItem>
                                <Separator />
                                <MenuItem Header="{l:T Delete}"
                                          Command="{Binding PlacementTarget.Tag.ViewModel.DeleteNodeCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding}">
                                    <MenuItem.Icon><ui:SymbolIcon Symbol="Delete24" Foreground="{StaticResource WarningBrush}" /></MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>

                            <HierarchicalDataTemplate DataType="{x:Type items:FileSystemNodeViewModel}"
                                                     ItemsSource="{Binding Children}">
                                <Border ContextMenu="{StaticResource NodeContextMenu}"
                                        Background="Transparent"
                                        Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftDoubleClick"
                                                      Command="{Binding DataContext.ViewModel.DrillIntoVmCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      CommandParameter="{Binding}" />
                                    </Border.InputBindings>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="80" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock VerticalAlignment="Center"
                                                   Text="{Binding Name}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                                   FontSize="11" Opacity="0.6" Margin="8,0">
                                            <Run Text="{Binding FileCount, Mode=OneWay}" />
                                            <Run Text="x" />
                                        </TextBlock>
                                        <TextBlock Grid.Column="2" VerticalAlignment="Center"
                                                   HorizontalAlignment="Right"
                                                   FontWeight="SemiBold"
                                                   Text="{Binding Size, Converter={StaticResource BytesToSize}}" />
                                    </Grid>
                                </Border>
                            </HierarchicalDataTemplate>
                        </TreeView.Resources>
                    </TreeView>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Status -->
        <Grid Grid.Row="4" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{Binding ViewModel.StatusText}" Opacity="0.8" />
                <ProgressBar Height="4" Margin="0,8,0,0" IsIndeterminate="True"
                             Visibility="{Binding ViewModel.IsScanning, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Opacity="0.7" Margin="0,0,16,0">
                    <Run Text="{Binding ViewModel.FilesScanned, Mode=OneWay}" />
                    <Run Text=" Datei(en)" />
                </TextBlock>
                <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource CleanerAccentBrush}"
                           Text="{Binding ViewModel.BytesScanned, Converter={StaticResource BytesToSize}}" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
