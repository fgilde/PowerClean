<UserControl x:Class="Cleaner.App.Views.Pages.DuplicatesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:vm="clr-namespace:Cleaner.App.ViewModels.Pages"
      xmlns:l="clr-namespace:Cleaner.App.Localization"
      xmlns:core="clr-namespace:Cleaner.Core.Services;assembly=Cleaner.Core"
      xmlns:sys="clr-namespace:System;assembly=netstandard"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance Type=vm:DuplicatesViewModel}"
      >
    <Grid Margin="40,24,40,40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="{l:T Duplicates.Title}" Style="{StaticResource PageTitle}" />
            <TextBlock Text="{l:T Duplicates.Subtitle}"
                       Style="{StaticResource PageSubtitle}" />
        </StackPanel>

        <!-- Toolbar -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <ui:Button Appearance="Primary" Icon="{ui:SymbolIcon Search24}"
                               Content="{l:T Duplicates.Find}"
                               Command="{Binding ViewModel.FindCommand}" />
                    <ui:Button Appearance="Secondary" Icon="{ui:SymbolIcon FolderAdd24}"
                               Margin="8,0,0,0" Content="{l:T FolderAdd}"
                               Command="{Binding ViewModel.AddSearchRootCommand}" />
                    <ui:Button Appearance="Caution" Icon="{ui:SymbolIcon Dismiss24}"
                               Margin="8,0,0,0" Content="{l:T Cancel}"
                               Command="{Binding ViewModel.CancelCommand}"
                               Visibility="{Binding ViewModel.IsScanning, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                    <TextBlock Style="{StaticResource StatLabel}" Text="{l:T Duplicates.Wasted}" />
                    <TextBlock FontSize="22" FontWeight="SemiBold"
                               Foreground="{StaticResource WarningBrush}"
                               Text="{Binding ViewModel.WastedTotal, Converter={StaticResource BytesToSize}}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Search roots -->
        <ItemsControl Grid.Row="2" ItemsSource="{Binding ViewModel.SearchRoots}" Margin="0,0,0,16">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border CornerRadius="14" Background="{DynamicResource ControlFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1" Padding="10,4" Margin="0,0,8,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding}" VerticalAlignment="Center" />
                            <ui:Button Appearance="Transparent" Padding="4" Margin="6,0,0,0"
                                       Icon="{ui:SymbolIcon Dismiss12}"
                                       Command="{Binding DataContext.ViewModel.RemoveSearchRootCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                       CommandParameter="{Binding}" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Groups -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding ViewModel.Groups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type core:DuplicateGroup}">
                            <Expander Margin="12,8" Padding="0">
                                <Expander.Header>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock>
                                            <Run Text="{Binding Paths.Count, Mode=OneWay}" />
                                            <Run Text=" Kopien · " />
                                            <Run Text="{Binding FileSize, Converter={StaticResource BytesToSize}, Mode=OneWay}" />
                                            <Run Text=" pro Stück" />
                                        </TextBlock>
                                        <TextBlock Grid.Column="1" Margin="16,0" Opacity="0.6"
                                                   Text="{Binding Hash, StringFormat='SHA: {0:0}'}"
                                                   TextTrimming="CharacterEllipsis" MaxWidth="140" />
                                        <TextBlock Grid.Column="2" FontWeight="SemiBold"
                                                   Foreground="{StaticResource WarningBrush}"
                                                   Text="{Binding WastedBytes, Converter={StaticResource BytesToSize}}" />
                                    </Grid>
                                </Expander.Header>
                                <ItemsControl ItemsSource="{Binding Paths}" Margin="0,8,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="8,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding}" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" />
                                                <ui:Button Grid.Column="1" Appearance="Danger" Padding="8,4"
                                                           Icon="{ui:SymbolIcon Delete24}"
                                                           Content="{l:T Delete}"
                                                           Command="{Binding DataContext.ViewModel.DeleteDuplicateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                           CommandParameter="{Binding}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Expander>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="4" Margin="0,16,0,0">
            <TextBlock Text="{Binding ViewModel.StatusText}" Opacity="0.8" />
            <ProgressBar Height="4" Margin="0,8,0,0" IsIndeterminate="True"
                         Visibility="{Binding ViewModel.IsScanning, Converter={StaticResource BoolToVis}}" />
        </StackPanel>
    </Grid>
</UserControl>
