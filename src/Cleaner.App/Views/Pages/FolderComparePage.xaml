<UserControl x:Class="Cleaner.App.Views.Pages.FolderComparePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:vm="clr-namespace:Cleaner.App.ViewModels.Pages"
      xmlns:l="clr-namespace:Cleaner.App.Localization"
      xmlns:core="clr-namespace:Cleaner.Core.Services;assembly=Cleaner.Core"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance Type=vm:FolderCompareViewModel}"
      >
    <UserControl.Resources>
        <!-- Status → Brush mapping for badges -->
        <SolidColorBrush x:Key="StatusEqualBrush" Color="#8A8A8A" />
        <SolidColorBrush x:Key="StatusDifferentBrush" Color="#D29922" />
        <SolidColorBrush x:Key="StatusLeftOnlyBrush" Color="#58A6FF" />
        <SolidColorBrush x:Key="StatusRightOnlyBrush" Color="#3FB950" />
    </UserControl.Resources>

    <Grid Margin="40,24,40,40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="{l:T FolderCompare.Title}" Style="{StaticResource PageTitle}" />
            <TextBlock Text="{l:T FolderCompare.Subtitle}"
                       Style="{StaticResource PageSubtitle}" />
        </StackPanel>

        <!-- Toolbar: paths + actions -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left path -->
                <Grid Grid.Row="0" Grid.Column="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBox PlaceholderText="{l:T FolderCompare.LeftPath}"
                                Text="{Binding ViewModel.LeftPath, UpdateSourceTrigger=PropertyChanged}" />
                    <ui:Button Grid.Column="1" Appearance="Secondary"
                               Padding="10,6" Margin="6,0,0,0"
                               Icon="{ui:SymbolIcon Folder24}"
                               ToolTip="{l:T FolderCompare.LeftPath}"
                               Command="{Binding ViewModel.BrowseLeftCommand}" />
                </Grid>

                <!-- Right path -->
                <Grid Grid.Row="0" Grid.Column="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBox PlaceholderText="{l:T FolderCompare.RightPath}"
                                Text="{Binding ViewModel.RightPath, UpdateSourceTrigger=PropertyChanged}" />
                    <ui:Button Grid.Column="1" Appearance="Secondary"
                               Padding="10,6" Margin="6,0,0,0"
                               Icon="{ui:SymbolIcon Folder24}"
                               ToolTip="{l:T FolderCompare.RightPath}"
                               Command="{Binding ViewModel.BrowseRightCommand}" />
                </Grid>

                <StackPanel Grid.Row="0" Grid.Column="4" Orientation="Horizontal">
                    <ui:Button Appearance="Primary"
                               Icon="{ui:SymbolIcon BranchCompare24}"
                               Content="{l:T FolderCompare.Compare}"
                               Command="{Binding ViewModel.CompareCommand}"
                               IsEnabled="{Binding ViewModel.IsComparing, Converter={StaticResource InverseBoolToVis}}" />
                    <ui:Button Appearance="Caution" Margin="8,0,0,0"
                               Icon="{ui:SymbolIcon Dismiss24}"
                               Content="{l:T Cancel}"
                               Command="{Binding ViewModel.CancelCommand}"
                               Visibility="{Binding ViewModel.IsComparing, Converter={StaticResource BoolToVis}}" />
                </StackPanel>

                <!-- Filter row -->
                <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="5"
                            Orientation="Horizontal" Margin="0,12,0,0">
                    <TextBlock Text="{l:T Filter}" VerticalAlignment="Center"
                               Opacity="0.7" Margin="0,0,12,0" />
                    <CheckBox Content="{l:T FolderCompare.Filter.ShowEqual}"
                              IsChecked="{Binding ViewModel.ShowEqual}"
                              VerticalAlignment="Center" Margin="0,0,12,0" />
                    <CheckBox VerticalAlignment="Center" Margin="0,0,12,0"
                              IsChecked="{Binding ViewModel.ShowDifferent}">
                        <CheckBox.Content>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="10" Height="10" CornerRadius="5"
                                        Background="{StaticResource StatusDifferentBrush}"
                                        VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock Text="{l:T FolderCompare.Status.Different}" />
                            </StackPanel>
                        </CheckBox.Content>
                    </CheckBox>
                    <CheckBox VerticalAlignment="Center" Margin="0,0,12,0"
                              IsChecked="{Binding ViewModel.ShowLeftOnly}">
                        <CheckBox.Content>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="10" Height="10" CornerRadius="5"
                                        Background="{StaticResource StatusLeftOnlyBrush}"
                                        VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock Text="{l:T FolderCompare.Status.LeftOnly}" />
                            </StackPanel>
                        </CheckBox.Content>
                    </CheckBox>
                    <CheckBox VerticalAlignment="Center"
                              IsChecked="{Binding ViewModel.ShowRightOnly}">
                        <CheckBox.Content>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="10" Height="10" CornerRadius="5"
                                        Background="{StaticResource StatusRightOnlyBrush}"
                                        VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock Text="{l:T FolderCompare.Status.RightOnly}" />
                            </StackPanel>
                        </CheckBox.Content>
                    </CheckBox>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Stats strip -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,12">
            <Border Padding="10,4" Margin="0,0,8,0" CornerRadius="10"
                    Background="{StaticResource StatusEqualBrush}">
                <TextBlock Foreground="White" FontWeight="SemiBold">
                    <Run Text="{l:T FolderCompare.Status.Equal}" />
                    <Run Text=": " />
                    <Run Text="{Binding ViewModel.EqualCount, Mode=OneWay}" />
                </TextBlock>
            </Border>
            <Border Padding="10,4" Margin="0,0,8,0" CornerRadius="10"
                    Background="{StaticResource StatusDifferentBrush}">
                <TextBlock Foreground="White" FontWeight="SemiBold">
                    <Run Text="{l:T FolderCompare.Status.Different}" />
                    <Run Text=": " />
                    <Run Text="{Binding ViewModel.DifferentCount, Mode=OneWay}" />
                </TextBlock>
            </Border>
            <Border Padding="10,4" Margin="0,0,8,0" CornerRadius="10"
                    Background="{StaticResource StatusLeftOnlyBrush}">
                <TextBlock Foreground="White" FontWeight="SemiBold">
                    <Run Text="{l:T FolderCompare.Status.LeftOnly}" />
                    <Run Text=": " />
                    <Run Text="{Binding ViewModel.LeftOnlyCount, Mode=OneWay}" />
                </TextBlock>
            </Border>
            <Border Padding="10,4" Margin="0,0,8,0" CornerRadius="10"
                    Background="{StaticResource StatusRightOnlyBrush}">
                <TextBlock Foreground="White" FontWeight="SemiBold">
                    <Run Text="{l:T FolderCompare.Status.RightOnly}" />
                    <Run Text=": " />
                    <Run Text="{Binding ViewModel.RightOnlyCount, Mode=OneWay}" />
                </TextBlock>
            </Border>
        </StackPanel>

        <!-- Main result grid -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="0">
            <DataGrid x:Name="ResultsGrid"
                      ItemsSource="{Binding ViewModel.EntriesView}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False" CanUserDeleteRows="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column" GridLinesVisibility="None"
                      Background="Transparent" BorderThickness="0"
                      RowBackground="Transparent" AlternatingRowBackground="#08000000"
                      MouseDoubleClick="ResultsGrid_MouseDoubleClick">
                <DataGrid.Resources>
                    <ContextMenu x:Key="RowContextMenu">
                        <MenuItem Header="{l:T FolderCompare.OpenDiff}"
                                  Command="{Binding PlacementTarget.Tag.ViewModel.OpenFileDiffCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding}">
                            <MenuItem.Icon><ui:SymbolIcon Symbol="BranchCompare24" /></MenuItem.Icon>
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="{l:T Reveal}"
                                  Command="{Binding PlacementTarget.Tag.ViewModel.RevealLeftCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding}">
                            <MenuItem.Icon><ui:SymbolIcon Symbol="Folder24" /></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="{l:T Reveal}"
                                  Command="{Binding PlacementTarget.Tag.ViewModel.RevealRightCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding}">
                            <MenuItem.Icon><ui:SymbolIcon Symbol="Folder24" /></MenuItem.Icon>
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="{l:T CopyPath}"
                                  Command="{Binding PlacementTarget.Tag.ViewModel.CopyLeftPathCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding}">
                            <MenuItem.Icon><ui:SymbolIcon Symbol="Copy24" /></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="{l:T CopyPath}"
                                  Command="{Binding PlacementTarget.Tag.ViewModel.CopyRightPathCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding}">
                            <MenuItem.Icon><ui:SymbolIcon Symbol="Copy24" /></MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </DataGrid.Resources>
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="ContextMenu" Value="{StaticResource RowContextMenu}" />
                        <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="{l:T Col.Status}" Width="140" SortMemberPath="Status">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type core:CompareEntry}">
                                <Border CornerRadius="10" Padding="8,2"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{StaticResource StatusEqualBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="Equal">
                                                    <Setter Property="Background" Value="{StaticResource StatusEqualBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Different">
                                                    <Setter Property="Background" Value="{StaticResource StatusDifferentBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="LeftOnly">
                                                    <Setter Property="Background" Value="{StaticResource StatusLeftOnlyBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="RightOnly">
                                                    <Setter Property="Background" Value="{StaticResource StatusRightOnlyBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Foreground="White" FontWeight="SemiBold" FontSize="11">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="{Binding Status}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="Equal">
                                                        <Setter Property="Text" Value="{l:T FolderCompare.Status.Equal}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Different">
                                                        <Setter Property="Text" Value="{l:T FolderCompare.Status.Different}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="LeftOnly">
                                                        <Setter Property="Text" Value="{l:T FolderCompare.Status.LeftOnly}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="RightOnly">
                                                        <Setter Property="Text" Value="{l:T FolderCompare.Status.RightOnly}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="{l:T Col.Path}" Binding="{Binding RelativePath}" Width="*" />
                    <DataGridTextColumn Header="Left size"
                                        Binding="{Binding LeftSize, Converter={StaticResource BytesToSize}}"
                                        Width="100" />
                    <DataGridTextColumn Header="Right size"
                                        Binding="{Binding RightSize, Converter={StaticResource BytesToSize}}"
                                        Width="100" />
                    <DataGridTextColumn Header="Left date"
                                        Binding="{Binding LeftLastWriteUtc, StringFormat={}{0:yyyy-MM-dd HH:mm}}"
                                        Width="130" />
                    <DataGridTextColumn Header="Right date"
                                        Binding="{Binding RightLastWriteUtc, StringFormat={}{0:yyyy-MM-dd HH:mm}}"
                                        Width="130" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Status -->
        <StackPanel Grid.Row="4" Margin="0,16,0,0">
            <TextBlock Text="{Binding ViewModel.StatusText}" Opacity="0.8" TextTrimming="CharacterEllipsis" />
            <ProgressBar Height="4" Margin="0,8,0,0" IsIndeterminate="True"
                         Visibility="{Binding ViewModel.IsComparing, Converter={StaticResource BoolToVis}}" />
        </StackPanel>
    </Grid>
</UserControl>
