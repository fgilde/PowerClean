<UserControl x:Class="Cleaner.App.Views.Pages.KillProfilesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:vm="clr-namespace:Cleaner.App.ViewModels.Pages"
      xmlns:l="clr-namespace:Cleaner.App.Localization"
      xmlns:nx="clr-namespace:Nextended.UI.WPF.Controls;assembly=Nextended.UI"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance Type=vm:KillProfilesViewModel}">
    <Grid Margin="40,24,40,40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="{l:T KillProfiles.Title}" Style="{StaticResource PageTitle}" />
            <TextBlock Text="{l:T KillProfiles.Subtitle}" Style="{StaticResource PageSubtitle}" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ui:Button Appearance="Primary" Icon="{ui:SymbolIcon Add24}"
                           Content="{l:T KillProfiles.Add}"
                           Command="{Binding ViewModel.AddProfileCommand}" />
                <TextBlock Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center"
                           Opacity="0.7" TextWrapping="Wrap"
                           Text="{l:T KillProfiles.HotkeyHint}" />
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding ViewModel.Profiles}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:KillProfileItemViewModel}">
                        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Kopfzeile: Name, Modus, Aktionen -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ui:TextBox Text="{Binding Name, UpdateSourceTrigger=LostFocus}"
                                                FontWeight="SemiBold" FontSize="15"
                                                PlaceholderText="{l:T KillProfiles.NamePlaceholder}" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0">
                                        <TextBlock Text="{l:T KillProfiles.Mode}" VerticalAlignment="Center" Margin="0,0,8,0" Opacity="0.8" />
                                        <ComboBox ItemsSource="{Binding Modes}"
                                                  SelectedItem="{Binding Mode}"
                                                  Width="120"
                                                  ToolTip="{l:T KillProfiles.ModeToolTip}" />
                                    </StackPanel>
                                    <ui:Button Grid.Column="2" Appearance="Danger"
                                               Icon="{ui:SymbolIcon Flash24}"
                                               Content="{l:T KillProfiles.Execute}"
                                               Command="{Binding DataContext.ViewModel.ExecuteProfileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                               CommandParameter="{Binding}" />
                                    <ui:Button Grid.Column="3" Appearance="Secondary" Margin="8,0,0,0"
                                               Icon="{ui:SymbolIcon Delete24}"
                                               ToolTip="{l:T Delete}"
                                               Command="{Binding DataContext.ViewModel.DeleteProfileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                               CommandParameter="{Binding}" />
                                </Grid>

                                <!-- Patterns -->
                                <Grid Grid.Row="1" Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{l:T KillProfiles.Patterns}" VerticalAlignment="Center" Opacity="0.8" />
                                    <ui:TextBox Grid.Column="1"
                                                Text="{Binding PatternsText, UpdateSourceTrigger=LostFocus}"
                                                PlaceholderText="{l:T KillProfiles.PatternsPlaceholder}" />
                                </Grid>

                                <!-- Shortcut -->
                                <Grid Grid.Row="2" Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{l:T KillProfiles.Shortcut}" VerticalAlignment="Center" Opacity="0.8" />
                                    <nx:KeyBindChanger Grid.Column="1"
                                                       HorizontalAlignment="Left"
                                                       MinWidth="220"
                                                       WithBorder="False"
                                                       KeyBind="{Binding ShortcutBinding, Mode=TwoWay}"
                                                       KeyBindChanged="Shortcut_OnKeyBindChanged"
                                                       BindingManager="{Binding DataContext.ViewModel.BindingManager, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                </Grid>

                                <!-- Treffer-Vorschau (nur auf Knopfdruck — Prozess-Scan ist teuer) -->
                                <StackPanel Grid.Row="3" Margin="0,8,0,0">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <ui:Button Appearance="Secondary" Padding="6,2" FontSize="11"
                                                   Icon="{ui:SymbolIcon Eye24}"
                                                   Content="{l:T KillProfiles.ShowMatches}"
                                                   Command="{Binding RefreshMatchesCommand}" />
                                        <TextBlock Text="{Binding MatchSummary}" Opacity="0.85" FontWeight="SemiBold"
                                                   VerticalAlignment="Center" Margin="12,0,0,0" />
                                    </StackPanel>
                                    <ItemsControl ItemsSource="{Binding Matches}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#22808080" CornerRadius="4" Padding="6,2" Margin="0,0,6,6">
                                                    <TextBlock FontSize="11" Opacity="0.9">
                                                        <Run Text="{Binding Name, Mode=OneWay}" />
                                                        <Run Text="{Binding Pid, Mode=OneWay, StringFormat=(PID {0})}" Foreground="Gray" />
                                                    </TextBlock>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <TextBlock Grid.Row="3" Text="{Binding ViewModel.StatusText}" Opacity="0.8" Margin="0,16,0,0" TextWrapping="Wrap" />
    </Grid>
</UserControl>
