<UserControl x:Class="Cleaner.App.Views.Pages.LargeFilesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:vm="clr-namespace:Cleaner.App.ViewModels.Pages"
      xmlns:l="clr-namespace:Cleaner.App.Localization"
      xmlns:core="clr-namespace:Cleaner.Core.Services;assembly=Cleaner.Core"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance Type=vm:LargeFilesViewModel}"
      >
    <Grid Margin="40,24,40,40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="{l:T LargeFiles.Title}" Style="{StaticResource PageTitle}" />
            <TextBlock Text="{l:T LargeFiles.Subtitle}"
                       Style="{StaticResource PageSubtitle}" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <ui:Button Appearance="Primary" Icon="{ui:SymbolIcon Search24}"
                           Content="{l:T Cleaner.ScanStart}"
                           Command="{Binding ViewModel.FindCommand}" />
                <ui:Button Appearance="Secondary" Icon="{ui:SymbolIcon FolderAdd24}"
                           Margin="8,0,0,0" Content="{l:T FolderAdd}"
                           Command="{Binding ViewModel.AddSearchRootCommand}" />
                <ui:Button Appearance="Caution" Icon="{ui:SymbolIcon Dismiss24}"
                           Margin="8,0,0,0" Content="{l:T Cancel}"
                           Command="{Binding ViewModel.CancelCommand}"
                           Visibility="{Binding ViewModel.IsScanning, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
        </Border>

        <ItemsControl Grid.Row="2" ItemsSource="{Binding ViewModel.SearchRoots}" Margin="0,0,0,16">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border CornerRadius="14" Background="{DynamicResource ControlFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1" Padding="10,4" Margin="0,0,8,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding}" VerticalAlignment="Center" />
                            <ui:Button Appearance="Transparent" Padding="4" Margin="6,0,0,0"
                                       Icon="{ui:SymbolIcon Dismiss12}"
                                       Command="{Binding DataContext.ViewModel.RemoveSearchRootCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                       CommandParameter="{Binding}" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="0">
            <DataGrid ItemsSource="{Binding ViewModel.Files}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False" CanUserDeleteRows="False"
                      HeadersVisibility="Column" GridLinesVisibility="None"
                      Background="Transparent" BorderThickness="0"
                      RowBackground="Transparent" AlternatingRowBackground="#08000000">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{l:T Col.Name}" Binding="{Binding Path}" Width="*" />
                    <DataGridTextColumn Header="{l:T Col.Size}" Binding="{Binding Size, Converter={StaticResource BytesToSize}}" Width="120" />
                    <DataGridTextColumn Header="{l:T Col.Modified}" Binding="{Binding LastWriteUtc, StringFormat={}{0:yyyy-MM-dd}}" Width="120" />
                    <DataGridTemplateColumn Header="" Width="170">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type core:LargeFileEntry}">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <ui:Button Appearance="Secondary" Padding="6,2" FontSize="12"
                                               Icon="{ui:SymbolIcon Folder24}"
                                               Content="{l:T Reveal}"
                                               Command="{Binding DataContext.ViewModel.RevealCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                               CommandParameter="{Binding}" />
                                    <ui:Button Appearance="Danger" Padding="6,2" Margin="4,0,0,0" FontSize="12"
                                               Icon="{ui:SymbolIcon Delete24}"
                                               Content="{l:T Delete}"
                                               Command="{Binding DataContext.ViewModel.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                               CommandParameter="{Binding}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <StackPanel Grid.Row="4" Margin="0,16,0,0">
            <TextBlock Text="{Binding ViewModel.StatusText}" Opacity="0.8" />
            <ProgressBar Height="4" Margin="0,8,0,0" IsIndeterminate="True"
                         Visibility="{Binding ViewModel.IsScanning, Converter={StaticResource BoolToVis}}" />
        </StackPanel>
    </Grid>
</UserControl>
