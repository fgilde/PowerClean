<UserControl x:Class="Cleaner.App.Views.Pages.LogFinderPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:vm="clr-namespace:Cleaner.App.ViewModels.Pages"
      xmlns:items="clr-namespace:Cleaner.App.ViewModels.Items"
      xmlns:l="clr-namespace:Cleaner.App.Localization"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance Type=vm:LogFinderViewModel}"
      >
    <Grid Margin="40,24,40,40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="{l:T LogFinder.Title}" Style="{StaticResource PageTitle}" />
            <TextBlock Text="{l:T LogFinder.Subtitle}"
                       Style="{StaticResource PageSubtitle}" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Aktions-Buttons links -->
                <StackPanel Orientation="Horizontal">
                    <ui:Button Appearance="Primary" Icon="{ui:SymbolIcon Search24}"
                               Content="{l:T Cleaner.ScanStart}"
                               Command="{Binding ViewModel.FindCommand}"
                               IsEnabled="{Binding ViewModel.IsScanning, Converter={StaticResource InverseBoolToVis}}" />
                    <ui:Button Appearance="Secondary" Icon="{ui:SymbolIcon FolderAdd24}"
                               Margin="8,0,0,0" Content="{l:T FolderAdd}"
                               Command="{Binding ViewModel.AddSearchRootCommand}" />
                    <Border Width="1" Background="{DynamicResource ControlStrokeColorDefaultBrush}" Margin="12,4" />
                    <ui:Button Appearance="Secondary" Padding="10,6" FontSize="12"
                               Icon="{ui:SymbolIcon CheckmarkStarburst24}"
                               Content="{l:T LogFinder.SelectRecommended}"
                               Command="{Binding ViewModel.SelectRecommendedCommand}" />
                    <ui:Button Appearance="Transparent" Padding="10,6" FontSize="12" Margin="4,0,0,0"
                               Content="{l:T LogFinder.SelectAll}"
                               Command="{Binding ViewModel.SelectAllCommand}" />
                    <ui:Button Appearance="Transparent" Padding="10,6" FontSize="12" Margin="4,0,0,0"
                               Content="{l:T LogFinder.SelectNone}"
                               Command="{Binding ViewModel.SelectNoneCommand}" />
                    <Border Width="1" Background="{DynamicResource ControlStrokeColorDefaultBrush}" Margin="12,4" />
                    <ui:DropDownButton Appearance="Danger"
                                       Icon="{ui:SymbolIcon Delete24}"
                                       Content="{l:T LogFinder.DeleteSelected}"
                                       Tag="{Binding .}">
                        <ui:DropDownButton.Flyout>
                            <ContextMenu>
                                <MenuItem Header="{l:T Cleaner.MoveToRecycleBin}"
                                          Command="{Binding PlacementTarget.Tag.ViewModel.DeleteSelectedCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="recycle">
                                    <MenuItem.Icon><ui:SymbolIcon Symbol="Delete24" /></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="{l:T Cleaner.DeletePermanent}"
                                          Command="{Binding PlacementTarget.Tag.ViewModel.DeleteSelectedCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="permanent">
                                    <MenuItem.Icon><ui:SymbolIcon Symbol="DeleteOff24" Foreground="{StaticResource WarningBrush}" /></MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </ui:DropDownButton.Flyout>
                    </ui:DropDownButton>
                </StackPanel>

                <!-- Stat-Boxen rechts (analog zu Cleaner-Panel) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <StackPanel Margin="24,0">
                        <TextBlock Style="{StaticResource StatLabel}" Text="{l:T Cleaner.Found}" />
                        <TextBlock FontSize="22" FontWeight="SemiBold"
                                   Text="{Binding ViewModel.TotalSize, Converter={StaticResource BytesToSize}}" />
                    </StackPanel>
                    <StackPanel Margin="24,0">
                        <TextBlock Style="{StaticResource StatLabel}" Text="{l:T Cleaner.Selected}" />
                        <TextBlock FontSize="22" FontWeight="SemiBold"
                                   Foreground="{DynamicResource CleanerAccentBrush}"
                                   Text="{Binding ViewModel.SelectedSize, Converter={StaticResource BytesToSize}}" />
                    </StackPanel>
                </StackPanel>

                <ui:Button Grid.Column="2" Appearance="Caution" Icon="{ui:SymbolIcon Dismiss24}"
                           Content="{l:T Cancel}"
                           Command="{Binding ViewModel.CancelCommand}"
                           Visibility="{Binding ViewModel.IsScanning, Converter={StaticResource BoolToVis}}"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- Info-Zeile: Default-Roots werden nicht als Chips angezeigt (zu viele, statisch).
             Statt dessen ein dezenter Hinweis was inkludiert ist. -->
        <TextBlock Grid.Row="2" Opacity="0.65" FontSize="12" Margin="0,0,0,8"
                   Text="{l:T LogFinder.DefaultRootsHint}" TextWrapping="Wrap" />

        <!-- Chips für die EXTRA-Roots die der User dazugepackt hat. -->
        <ItemsControl Grid.Row="3" ItemsSource="{Binding ViewModel.ExtraRoots}" Margin="0,0,0,12">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border CornerRadius="14" Background="{DynamicResource ControlFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1" Padding="10,4" Margin="0,0,8,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding}" VerticalAlignment="Center" />
                            <ui:Button Appearance="Transparent" Padding="4" Margin="6,0,0,0"
                                       Icon="{ui:SymbolIcon Dismiss12}"
                                       Command="{Binding DataContext.ViewModel.RemoveSearchRootCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                       CommandParameter="{Binding}" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border Grid.Row="4" Style="{StaticResource Card}" Padding="0">
            <DataGrid ItemsSource="{Binding ViewModel.Files}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False" CanUserDeleteRows="False"
                      HeadersVisibility="Column" GridLinesVisibility="None"
                      Background="Transparent" BorderThickness="0"
                      RowBackground="Transparent" AlternatingRowBackground="#08000000">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="ContextMenu" Value="{StaticResource FileSystemPathMenu}" />
                        <Setter Property="Tag" Value="{Binding Path}" />
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="" Width="40">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type items:LogFileItemViewModel}">
                                <CheckBox HorizontalAlignment="Center"
                                          IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="{l:T Col.Path}" Binding="{Binding Path}" Width="*" />
                    <DataGridTextColumn Header="{l:T Col.Size}" Binding="{Binding Size, Converter={StaticResource BytesToSize}}" Width="100" />
                    <DataGridTextColumn Header="{l:T Col.Modified}" Binding="{Binding LastWriteUtc, StringFormat={}{0:yyyy-MM-dd}}" Width="110" />
                    <DataGridTextColumn Header="{l:T LogFinder.Col.Root}" Binding="{Binding Root}" Width="120" />
                    <DataGridTextColumn Header="{l:T LogFinder.Col.Pattern}" Binding="{Binding Pattern}" Width="100" />
                    <DataGridTemplateColumn Header="" Width="170">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type items:LogFileItemViewModel}">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <ui:Button Appearance="Secondary" Padding="6,2" FontSize="12"
                                               Icon="{ui:SymbolIcon Folder24}"
                                               Content="{l:T Reveal}"
                                               Command="{Binding DataContext.ViewModel.RevealCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                               CommandParameter="{Binding}" />
                                    <ui:Button Appearance="Danger" Padding="6,2" Margin="4,0,0,0" FontSize="12"
                                               Icon="{ui:SymbolIcon Delete24}"
                                               Content="{l:T Delete}"
                                               Command="{Binding DataContext.ViewModel.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                               CommandParameter="{Binding}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Grid Grid.Row="5" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{Binding ViewModel.StatusText}" Opacity="0.8" />
                <ProgressBar Height="4" Margin="0,8,0,0" IsIndeterminate="True"
                             Visibility="{Binding ViewModel.IsScanning, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Opacity="0.7" Margin="0,0,16,0">
                    <Run Text="{Binding ViewModel.Count, Mode=OneWay}" />
                    <Run Text=" " /><Run Text="{l:T Files}" />
                </TextBlock>
                <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource CleanerAccentBrush}"
                           Text="{Binding ViewModel.TotalSize, Converter={StaticResource BytesToSize}}" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
