<UserControl x:Class="Cleaner.App.Views.Pages.OrphanUserDataPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:vm="clr-namespace:Cleaner.App.ViewModels.Pages"
      xmlns:l="clr-namespace:Cleaner.App.Localization"
      xmlns:core="clr-namespace:Cleaner.Core.Services;assembly=Cleaner.Core"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance Type=vm:OrphanUserDataViewModel}"
      >
    <Grid Margin="40,24,40,40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="{l:T OrphanData.Title}" Style="{StaticResource PageTitle}" />
            <TextBlock Text="{l:T OrphanData.Subtitle}" Style="{StaticResource PageSubtitle}" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <ui:Button Appearance="Primary" Icon="{ui:SymbolIcon Search24}"
                           Content="{l:T OrphanData.ScanStart}"
                           Command="{Binding ViewModel.ScanCommand}"
                           IsEnabled="{Binding ViewModel.IsScanning, Converter={StaticResource InverseBoolToVis}}" />
                <ui:Button Appearance="Caution" Icon="{ui:SymbolIcon Dismiss24}"
                           Margin="8,0,0,0" Content="{l:T Cancel}"
                           Command="{Binding ViewModel.CancelCommand}"
                           Visibility="{Binding ViewModel.IsScanning, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
            <DataGrid ItemsSource="{Binding ViewModel.Entries}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False" CanUserDeleteRows="False"
                      HeadersVisibility="Column" GridLinesVisibility="None"
                      Background="Transparent" BorderThickness="0"
                      RowBackground="Transparent" AlternatingRowBackground="#08000000">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="ContextMenu" Value="{StaticResource FileSystemEntryMenu}" />
                        <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{l:T Col.Name}" Binding="{Binding Name}" Width="220" />
                    <DataGridTextColumn Header="{l:T OrphanData.Col.Root}" Binding="{Binding Root}" Width="100" />
                    <DataGridTextColumn Header="{l:T Col.Size}" Binding="{Binding SizeBytes, Converter={StaticResource BytesToSize}}" Width="110" />
                    <DataGridTextColumn Header="{l:T OrphanData.Col.LastModified}" Binding="{Binding LastModifiedUtc, StringFormat={}{0:yyyy-MM-dd}}" Width="110" />
                    <DataGridTextColumn Header="{l:T Col.Path}" Binding="{Binding FullPath}" Width="*" />
                    <DataGridTextColumn Header="{l:T OrphanData.Col.Reason}" Binding="{Binding Reason}" Width="260" />
                    <DataGridTemplateColumn Header="" Width="170">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type core:OrphanUserDataEntry}">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <ui:Button Appearance="Secondary" Padding="6,2" FontSize="12"
                                               Icon="{ui:SymbolIcon Folder24}"
                                               Content="{l:T Reveal}"
                                               Command="{Binding DataContext.ViewModel.OpenInExplorerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                               CommandParameter="{Binding}" />
                                    <ui:Button Appearance="Danger" Padding="6,2" Margin="4,0,0,0" FontSize="12"
                                               Icon="{ui:SymbolIcon Delete24}"
                                               Content="{l:T Delete}"
                                               Command="{Binding DataContext.ViewModel.DeleteNodeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                               CommandParameter="{Binding}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{Binding ViewModel.StatusText}" Opacity="0.8" />
                <ProgressBar Height="4" Margin="0,8,0,0" IsIndeterminate="True"
                             Visibility="{Binding ViewModel.IsScanning, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Opacity="0.7" Margin="0,0,16,0">
                    <Run Text="{Binding ViewModel.Count, Mode=OneWay}" />
                    <Run Text=" Ordner" />
                </TextBlock>
                <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource CleanerAccentBrush}"
                           Text="{Binding ViewModel.TotalSize, Converter={StaticResource BytesToSize}}" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
