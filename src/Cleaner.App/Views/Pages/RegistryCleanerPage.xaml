<UserControl x:Class="Cleaner.App.Views.Pages.RegistryCleanerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:vm="clr-namespace:Cleaner.App.ViewModels.Pages"
      xmlns:l="clr-namespace:Cleaner.App.Localization"
      xmlns:core="clr-namespace:Cleaner.Core.Services;assembly=Cleaner.Core"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance Type=vm:RegistryCleanerViewModel}">
    <Grid Margin="40,24,40,40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="{l:T Registry.Title}" Style="{StaticResource PageTitle}" />
            <TextBlock Text="{l:T Registry.Subtitle}"
                       Style="{StaticResource PageSubtitle}" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <ui:Button Appearance="Primary" Icon="{ui:SymbolIcon Search24}"
                               Content="{l:T Cleaner.ScanStart}" Command="{Binding ViewModel.ScanCommand}" />
                    <ui:Button Appearance="Danger" Margin="8,0,0,0"
                               Icon="{ui:SymbolIcon Delete24}"
                               Content="{l:T Registry.CleanSelected}"
                               Command="{Binding ViewModel.CleanCommand}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                    <ui:Button Appearance="Secondary" Padding="8,4" Margin="0,0,6,0" FontSize="11"
                               Content="{l:T Registry.SelectAll}"
                               Command="{Binding ViewModel.SelectAllCommand}" />
                    <ui:Button Appearance="Secondary" Padding="8,4" Margin="0,0,6,0" FontSize="11"
                               Content="{l:T Registry.SelectSafe}"
                               Command="{Binding ViewModel.SelectSafeCommand}" />
                    <ui:Button Appearance="Secondary" Padding="8,4" FontSize="11"
                               Content="{l:T Registry.SelectNone}"
                               Command="{Binding ViewModel.SelectNoneCommand}" />
                </StackPanel>
                <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                    <TextBlock Style="{StaticResource StatLabel}" Text="{l:T Cleaner.Selected}" />
                    <TextBlock FontSize="22" FontWeight="SemiBold"
                               Foreground="{DynamicResource CleanerAccentBrush}"
                               Text="{Binding ViewModel.SelectedCount}" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding ViewModel.IssuesView}">
                    <ItemsControl.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                            Padding="16,8" Margin="0,8,0,0">
                                        <TextBlock FontWeight="SemiBold">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="{}{0}   ·   {1} Eintrag/Einträge">
                                                    <Binding Path="Name" Mode="OneTime" />
                                                    <Binding Path="ItemCount" Mode="OneWay" />
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ItemsControl.GroupStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type core:RegistryIssue}">
                            <Border BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                    BorderThickness="0,0,0,1" Padding="20,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{Binding IsSelected}"
                                              VerticalAlignment="Center" Margin="0,0,12,0" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Detail}" Opacity="0.75" FontSize="11"
                                                   TextWrapping="Wrap" Margin="0,2,0,0" />
                                        <TextBlock Text="{Binding FullKeyPath}" Opacity="0.5" FontSize="10"
                                                   Margin="0,2,0,0" FontFamily="Consolas" />
                                    </StackPanel>
                                    <Border Grid.Column="2" CornerRadius="8" Padding="6,1"
                                            VerticalAlignment="Center"
                                            Background="{Binding Safety, Converter={StaticResource SafetyToBrush}}">
                                        <TextBlock Text="{Binding Safety}"
                                                   Foreground="White" FontSize="10" FontWeight="SemiBold" />
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{Binding ViewModel.StatusText}" Opacity="0.8" />
                <ProgressBar Height="4" Margin="0,8,0,0" IsIndeterminate="True"
                             Visibility="{Binding ViewModel.IsBusy, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
            <ui:Button Grid.Column="1" Appearance="Secondary"
                       Icon="{ui:SymbolIcon Folder24}"
                       Content="{l:T Registry.OpenBackupFolder}"
                       Command="{Binding ViewModel.OpenBackupFolderCommand}" />
        </Grid>
    </Grid>
</UserControl>
