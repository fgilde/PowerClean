<UserControl x:Class="Cleaner.App.Views.Pages.ServicesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:vm="clr-namespace:Cleaner.App.ViewModels.Pages"
      xmlns:l="clr-namespace:Cleaner.App.Localization"
      xmlns:controls="clr-namespace:Cleaner.App.Controls"
      xmlns:core="clr-namespace:Cleaner.Core.Services;assembly=Cleaner.Core"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance Type=vm:ServicesViewModel}">
    <Grid Margin="40,24,40,40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="{l:T Services.Title}" Style="{StaticResource PageTitle}" />
            <TextBlock Text="{l:T Services.Subtitle}"
                       Style="{StaticResource PageSubtitle}" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <ui:Button Appearance="Primary" Icon="{ui:SymbolIcon Search24}"
                               Content="{l:T Cleaner.ScanStart}" Command="{Binding ViewModel.ScanCommand}" />
                    <ui:Button Appearance="Secondary" Margin="8,0,0,0"
                               Icon="{ui:SymbolIcon Settings24}"
                               Content="{l:T Services.Console}"
                               ToolTip="Öffnet die klassische services.msc"
                               Command="{Binding ViewModel.OpenServicesMmcCommand}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <CheckBox Content="{l:T Services.OnlyRunning}" IsChecked="{Binding ViewModel.ShowOnlyRunning}" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <CheckBox Content="{l:T Services.OnlyRecommendations}" IsChecked="{Binding ViewModel.ShowOnlyRecommendations}" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <CheckBox Content="{l:T Services.HideMicrosoft}" IsChecked="{Binding ViewModel.HideMicrosoft}" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
            <controls:PowerGrid GridId="services" ItemsSource="{Binding ViewModel.Services}">
                <controls:PowerGrid.RowContextMenu>
                    <ContextMenu>
                        <MenuItem Header="{l:T Services.OpenFile}"
                                  Command="{Binding Tag.ViewModel.ShowFolderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding}">
                            <MenuItem.Icon><ui:SymbolIcon Symbol="Folder24" /></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="{l:T WindowsProperties}"
                                  Command="{Binding Tag.ViewModel.OpenPropertiesCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding}">
                            <MenuItem.Icon><ui:SymbolIcon Symbol="Info24" /></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="{l:T Services.CopyName}"
                                  Command="{Binding Tag.ViewModel.CopyServiceNameCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding}">
                            <MenuItem.Icon><ui:SymbolIcon Symbol="Copy24" /></MenuItem.Icon>
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="{l:T Services.Start}"
                                  Command="{Binding Tag.ViewModel.StartCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding}">
                            <MenuItem.Icon><ui:SymbolIcon Symbol="Play24" /></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="{l:T Services.Stop}"
                                  Command="{Binding Tag.ViewModel.StopCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding}">
                            <MenuItem.Icon><ui:SymbolIcon Symbol="Stop24" /></MenuItem.Icon>
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="{l:T Services.StartAuto}"
                                  Command="{Binding Tag.ViewModel.SetAutomaticCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding}" />
                        <MenuItem Header="{l:T Services.StartManual}"
                                  Command="{Binding Tag.ViewModel.SetManualCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding}" />
                        <MenuItem Header="{l:T Services.StartDisabled}"
                                  Command="{Binding Tag.ViewModel.DisableCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding}">
                            <MenuItem.Icon><ui:SymbolIcon Symbol="SubtractCircle24" Foreground="{StaticResource WarningBrush}" /></MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </controls:PowerGrid.RowContextMenu>

                <DataGridTextColumn Header="{l:T Col.DisplayName}" Binding="{Binding DisplayName}" Width="*" />
                <DataGridTextColumn Header="{l:T Col.ServiceName}" Binding="{Binding ServiceName}" Width="180" />
                <DataGridTextColumn Header="{l:T Col.Status}" Binding="{Binding Status}" Width="100" />
                <DataGridTextColumn Header="{l:T Col.StartType}" Binding="{Binding StartType}" Width="100" />
                <DataGridTextColumn Header="{l:T Sort.RAM}" Binding="{Binding RamBytes, Converter={StaticResource BytesToSize}}" SortMemberPath="RamBytes" Width="80" />
                <DataGridTemplateColumn Header="{l:T Col.Recommendation}" Width="*" SortMemberPath="Recommendation">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="{x:Type core:WindowsService}">
                            <TextBlock Text="{Binding Recommendation}"
                                       Foreground="{StaticResource CautionBrush}"
                                       FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="" Width="290" CanUserReorder="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="{x:Type core:WindowsService}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <ui:Button Appearance="Secondary" Padding="6,2" FontSize="11"
                                           Icon="{ui:SymbolIcon Play24}" Content="{l:T Services.Start}"
                                           Command="{Binding DataContext.ViewModel.StartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                           CommandParameter="{Binding}" />
                                <ui:Button Appearance="Secondary" Padding="6,2" FontSize="11" Margin="4,0,0,0"
                                           Icon="{ui:SymbolIcon Stop24}" Content="{l:T Stop}"
                                           Command="{Binding DataContext.ViewModel.StopCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                           CommandParameter="{Binding}" />
                                <ui:Button Appearance="Caution" Padding="6,2" FontSize="11" Margin="4,0,0,0"
                                           Icon="{ui:SymbolIcon Pause24}" Content="{l:T Services.Manual}"
                                           ToolTip="Start-Typ auf 'Manuell' (= läuft nicht von selbst)"
                                           Command="{Binding DataContext.ViewModel.SetManualCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                           CommandParameter="{Binding}" />
                                <ui:Button Appearance="Danger" Padding="6,2" FontSize="11" Margin="4,0,0,0"
                                           Icon="{ui:SymbolIcon SubtractCircle24}" Content="{l:T Services.Disable}"
                                           Command="{Binding DataContext.ViewModel.DisableCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                           CommandParameter="{Binding}" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </controls:PowerGrid>
        </Border>

        <StackPanel Grid.Row="3" Margin="0,16,0,0">
            <TextBlock Text="{Binding ViewModel.StatusText}" Opacity="0.8" />
            <ProgressBar Height="4" Margin="0,8,0,0" IsIndeterminate="True"
                         Visibility="{Binding ViewModel.IsLoading, Converter={StaticResource BoolToVis}}" />
        </StackPanel>
    </Grid>
</UserControl>
