<UserControl x:Class="Cleaner.App.Views.Pages.SystemMaintenancePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:vm="clr-namespace:Cleaner.App.ViewModels.Pages"
      xmlns:l="clr-namespace:Cleaner.App.Localization"
      xmlns:core="clr-namespace:Cleaner.Core.Services;assembly=Cleaner.Core"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance Type=vm:SystemMaintenanceViewModel}">

    <UserControl.Resources>
        <Style x:Key="MaintCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Margin" Value="0,0,16,16" />
            <Setter Property="Width" Value="350" />
            <Setter Property="Padding" Value="20,16" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="40,24,40,40">
        <StackPanel>
            <TextBlock Text="{l:T Maintenance.Title}" Style="{StaticResource PageTitle}" />
            <TextBlock Text="{l:T Maintenance.Subtitle}"
                       Style="{StaticResource PageSubtitle}" />

            <TextBlock Text="{l:T Maintenance.DiskSavers}" FontSize="16" FontWeight="SemiBold" Margin="0,16,0,12" />
            <WrapPanel>
                <Border Style="{StaticResource MaintCard}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <ui:SymbolIcon Symbol="Sleep24" FontSize="20" Foreground="{DynamicResource CleanerAccentBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{l:T Maintenance.Hibernation}" Margin="8,0,0,0" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock TextWrapping="Wrap" FontSize="12" Opacity="0.75"
                                   Text="{l:T Maintenance.HibernationDesc}" />
                        <Grid Margin="0,10,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource StatLabel}">
                                    <Run Text="{l:T Maintenance.HibernationStatus}" />
                                    <Run Text="{Binding ViewModel.HibernationEnabled, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock FontWeight="SemiBold" FontSize="16"
                                           Text="{Binding ViewModel.HibernationFileSize, Converter={StaticResource BytesToSize}}" />
                            </StackPanel>
                        </Grid>
                        <ui:Button Appearance="Primary" HorizontalAlignment="Stretch"
                                   Content="{l:T Maintenance.HibernationToggle}"
                                   Command="{Binding ViewModel.ToggleHibernationCommand}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource MaintCard}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <ui:SymbolIcon Symbol="Stack24" FontSize="20" Foreground="{DynamicResource CleanerAccentBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{l:T Maintenance.Pagefile}" Margin="8,0,0,0" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock TextWrapping="Wrap" FontSize="12" Opacity="0.75"
                                   Text="{l:T Maintenance.PagefileDesc}" />
                        <TextBlock Margin="0,10,0,12" FontWeight="SemiBold" FontSize="16"
                                   Text="{Binding ViewModel.PageFileSize, Converter={StaticResource BytesToSize}}" />
                        <ui:Button Appearance="Secondary" HorizontalAlignment="Stretch"
                                   Content="{l:T Maintenance.PagefileSettings}"
                                   Command="{Binding ViewModel.OpenSpaceSettingsCommand}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource MaintCard}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <ui:SymbolIcon Symbol="HistoryDismiss24" FontSize="20" Foreground="{DynamicResource CleanerAccentBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{l:T Maintenance.RestorePoints}" Margin="8,0,0,0" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock TextWrapping="Wrap" FontSize="12" Opacity="0.75"
                                   Text="{l:T Maintenance.RestorePointsDesc}" />
                        <TextBlock Margin="0,10,0,12">
                            <Run FontWeight="SemiBold" FontSize="16" Text="{Binding ViewModel.RestorePointCount, Mode=OneWay}" />
                            <Run Text=" {l:T Maintenance.RestorePointsFound}" />
                        </TextBlock>
                        <StackPanel Orientation="Vertical">
                            <ui:Button Appearance="Secondary" HorizontalAlignment="Stretch" Margin="0,0,0,6"
                                       Content="{l:T Maintenance.RestorePointsList}"
                                       Command="{Binding ViewModel.LoadRestorePointsCommand}" />
                            <ui:Button Appearance="Caution" HorizontalAlignment="Stretch" Margin="0,0,0,6"
                                       Content="{l:T Maintenance.RestorePointsDeleteOld}"
                                       Command="{Binding ViewModel.DeleteOldRestorePointsCommand}" />
                            <ui:Button Appearance="Danger" HorizontalAlignment="Stretch"
                                       Content="{l:T Maintenance.RestorePointsDeleteAll}"
                                       Command="{Binding ViewModel.DeleteAllRestorePointsCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource MaintCard}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <ui:SymbolIcon Symbol="Wrench24" FontSize="20" Foreground="{DynamicResource CleanerAccentBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{l:T Maintenance.WinComponents}" Margin="8,0,0,0" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock TextWrapping="Wrap" FontSize="12" Opacity="0.75"
                                   Text="{l:T Maintenance.WinComponentsDesc}" />
                        <StackPanel Margin="0,12,0,0">
                            <ui:Button Appearance="Primary" HorizontalAlignment="Stretch" Margin="0,0,0,6"
                                       Content="{l:T Maintenance.WinComponentsCleanup}"
                                       Command="{Binding ViewModel.RunDismCleanupCommand}" />
                            <ui:Button Appearance="Danger" HorizontalAlignment="Stretch"
                                       Content="{l:T Maintenance.WinComponentsResetBase}"
                                       ToolTip="Permanente Entfernung alter Updates — keine Rollbacks mehr möglich"
                                       Command="{Binding ViewModel.RunDismResetBaseCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </WrapPanel>

            <TextBlock Text="{l:T Maintenance.QuickActions}" FontSize="16" FontWeight="SemiBold" Margin="0,16,0,12" />
            <WrapPanel>
                <Border Style="{StaticResource MaintCard}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <ui:SymbolIcon Symbol="Globe24" FontSize="20" Foreground="{DynamicResource CleanerAccentBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{l:T Maintenance.DnsCache}" Margin="8,0,0,0" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock TextWrapping="Wrap" FontSize="12" Opacity="0.75"
                                   Text="{l:T Maintenance.DnsCacheDesc}" />
                        <ui:Button Appearance="Primary" HorizontalAlignment="Stretch" Margin="0,12,0,0"
                                   Content="{l:T Maintenance.DnsCacheFlush}"
                                   Command="{Binding ViewModel.FlushDnsCommand}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource MaintCard}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <ui:SymbolIcon Symbol="Print24" FontSize="20" Foreground="{DynamicResource CleanerAccentBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{l:T Maintenance.PrintQueue}" Margin="8,0,0,0" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock TextWrapping="Wrap" FontSize="12" Opacity="0.75"
                                   Text="{l:T Maintenance.PrintQueueDesc}" />
                        <ui:Button Appearance="Primary" HorizontalAlignment="Stretch" Margin="0,12,0,0"
                                   Content="{l:T Maintenance.PrintQueueFlush}"
                                   Command="{Binding ViewModel.FlushPrintQueueCommand}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource MaintCard}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <ui:SymbolIcon Symbol="Delete24" FontSize="20" Foreground="{DynamicResource CleanerAccentBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{l:T Maintenance.RecycleBin}" Margin="8,0,0,0" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock TextWrapping="Wrap" FontSize="12" Opacity="0.75"
                                   Text="{l:T Maintenance.RecycleBinDesc}" />
                        <ui:Button Appearance="Primary" HorizontalAlignment="Stretch" Margin="0,12,0,0"
                                   Content="{l:T Maintenance.RecycleBinEmpty}"
                                   Command="{Binding ViewModel.EmptyRecycleBinCommand}" />
                    </StackPanel>
                </Border>
            </WrapPanel>

            <!-- Restore-Points-Liste -->
            <TextBlock Text="{l:T Maintenance.RestorePointsListHeader}" FontSize="16" FontWeight="SemiBold" Margin="0,24,0,12"
                       Visibility="{Binding ViewModel.RestorePointCount, Converter={StaticResource NullToVis}}" />
            <Border Style="{StaticResource Card}" Padding="0" Visibility="{Binding ViewModel.RestorePointCount, Converter={StaticResource NullToVis}}">
                <DataGrid ItemsSource="{Binding ViewModel.RestorePoints}"
                          AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                          HeadersVisibility="Column" GridLinesVisibility="None"
                          Background="Transparent" BorderThickness="0"
                          RowBackground="Transparent" AlternatingRowBackground="#08000000"
                          MaxHeight="300">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="#" Binding="{Binding SequenceNumber}" Width="60" />
                        <DataGridTextColumn Header="{l:T Col.Created}"
                                            Binding="{Binding CreationTimeUtc, StringFormat={}{0:yyyy-MM-dd HH:mm}}"
                                            Width="140" />
                        <DataGridTextColumn Header="{l:T Col.Description}" Binding="{Binding Description}" Width="*" />
                        <DataGridTextColumn Header="{l:T Col.Type}" Binding="{Binding Type}" Width="160" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Log -->
            <TextBlock Text="{l:T Maintenance.ActivityLog}" FontSize="16" FontWeight="SemiBold" Margin="0,24,0,12" />
            <Border Style="{StaticResource Card}" Padding="0">
                <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto">
                    <TextBox Text="{Binding ViewModel.Log, Mode=OneWay}"
                             IsReadOnly="True" Background="Transparent" BorderThickness="0"
                             FontFamily="Cascadia Mono, Consolas" FontSize="11"
                             Padding="16" TextWrapping="Wrap" />
                </ScrollViewer>
            </Border>

            <ProgressBar Height="4" Margin="0,16,0,0" IsIndeterminate="True"
                         Visibility="{Binding ViewModel.IsBusy, Converter={StaticResource BoolToVis}}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
